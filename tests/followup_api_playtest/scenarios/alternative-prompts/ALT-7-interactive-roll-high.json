          "equals": 1
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.skill_check",
          "path": "payload.toolInvocations",
          "where": {
            "name": "resolveSkillCheck",
            "metadata": {
              "checkType": "unopposed",
              "actionResolution": {
                "success": true,
                "roll": {
                  "die": 20
                },
                "skill": "Perception",
                "checkType": "unopposed"
              }
            }
          },
          "equals": 1
        },
        {
          "type": "equals",
          "source": "responses.skill_check",
          "path": "payload.checkResultsRecorded",
          "equals": true
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.skill_check",
          "path": "payload.messages",
