{
  "version": 1,
  "scenario": "alternative-prompts",
  "case": "ALT-7-interactive-roll-high",
  "description": "From its own fresh fixture restore, submit the same ordinary unopposed skill action with <f>, answer the single WebSocket roll request with 20, and prove the marker is stripped while the exact roll is injected once into resolveSkillCheck.",
  "fixture": "relationships-factions",
  "configProfile": "alternative-prompts-interactive-roll",
  "trackedPaths": [
    "player.payload.player",
    "players.payload.players",
    "locations.payload.locations",
    "regions.payload.regions",
    "things.payload.things",
    "factions.payload.factions",
    "factions.payload.playerStandings",
    "scheduledEvents.payload.scheduledEvents",
    "calendar.payload.worldTime",
    "history.payload.history"
  ],
  "steps": [
