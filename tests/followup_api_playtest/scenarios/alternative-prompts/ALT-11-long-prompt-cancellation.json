{
  "version": 1,
  "scenario": "alternative-prompts",
  "case": "ALT-11-long-prompt-cancellation",
  "description": "Start a deliberately long no-context generation, cancel it only after realtime prompt activity is observed, await the original request, and prove prompt drain and no gameplay mutation.",
  "fixture": "relationships-factions",
  "configProfile": "alternative-prompts-cancellation",
  "trackedPaths": [
    "player.payload.player",
    "players.payload.players",
    "locations.payload.locations",
    "regions.payload.regions",
    "things.payload.things",
    "factions.payload.factions",
    "factions.payload.playerStandings",
    "scheduledEvents.payload.scheduledEvents",
    "calendar.payload.worldTime",
    "history.payload.history"
  ],
  "steps": [
    { "type": "loadFixture" },
    { "type": "snapshot", "name": "before_long_cancel" },
    {
      "type": "startChat",
      "name": "long_generation",
      "text": "\\ Write a continuous response of at least 8000 words describing an imaginary library. Do not stop early.",
      "interactive": {
        "roll": null,
        "questAccepted": false,
        "confirmed": false
      }
    },
    {
      "type": "waitForRealtime",
      "name": "long_prompt_started",
      "until": [
        {
          "type": "arrayObjectCountAtLeast",
          "source": "realtime",
          "path": ".",
          "where": { "type": "prompt_progress" },
          "minimum": 1
        }
      ],
      "timeoutMs": 30000,
      "pollIntervalMs": 10
    },
    {
      "type": "request",
      "name": "cancel_long",
      "method": "POST",
      "route": "/api/prompts/cancel-all",
      "body": {
        "waitForDrain": true,
        "timeoutMs": 30000
      }
    },
    { "type": "awaitChat", "name": "long_generation" },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.cancel_long",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.cancel_long",
          "path": "payload.success",
          "equals": true
        },
        {
          "type": "greaterThanOrEqual",
          "source": "responses.cancel_long",
          "path": "payload.cancellation.canceledCount",
          "value": 1
        },
        {
          "type": "equals",
          "source": "responses.cancel_long",
          "path": "payload.drain.activeCount",
          "equals": 0
        },
        {
          "type": "equals",
          "source": "responses.cancel_long",
          "path": "payload.drain.trackedCount",
          "equals": 0
        },
        {
          "type": "equals",
          "source": "responses.long_generation",
          "path": "status",
          "equals": 500
        },
        {
          "type": "equals",
          "source": "responses.long_generation",
          "path": "payload.error",
          "equals": "AI returned an empty response for player action."
        },
        {
          "type": "historyAddedSequence",
          "beforeSource": "snapshots.before_long_cancel",
          "afterSource": "after",
          "entryTypes": ["user-generic-prompt", "generic-prompt-response"],
          "expected": [
            {
              "type": "user-generic-prompt",
              "role": "user",
              "content": "Write a continuous response of at least 8000 words describing an imaginary library. Do not stop early.",
              "metadata": {
                "excludeFromBaseContextHistory": true
              }
            }
          ]
        },
        {
          "type": "stateUnchanged",
          "beforeSource": "snapshots.before_long_cancel",
          "afterSource": "after",
          "paths": [
            "player.payload.player.id",
            "player.payload.player.level",
            "player.payload.player.health",
            "player.payload.player.maxHealth",
            "player.payload.player.locationId",
            "player.payload.player.experience",
            "player.payload.player.abilities",
            "player.payload.player.attributes",
            "player.payload.player.skills",
            "player.payload.player.inventory",
            "player.payload.player.currency",
            "player.payload.player.statusEffects",
            "player.payload.player.needBars",
            "player.payload.player.quests",
            "player.payload.player.completedQuests",
            "locations.payload.locations",
            "regions.payload.regions",
            "things.payload.things",
            "factions.payload.factions",
            "factions.payload.playerStandings",
            "scheduledEvents.payload.scheduledEvents",
            "calendar.payload.worldTime"
          ]
        },
        {
          "type": "historyAddedTypeCount",
          "beforeSource": "snapshots.before_long_cancel",
          "afterSource": "after",
          "entryType": "player-action",
          "equals": 0
        },
        {
          "type": "historyAddedTypeCount",
          "beforeSource": "snapshots.before_long_cancel",
          "afterSource": "after",
          "entryType": "event-summary",
          "equals": 0
        },
        { "type": "noRealtimeErrors" },
        { "type": "noUnexpectedErrorLogs" }
      ]
    }
  ],
  "humanReview": [
    "This branch tests cancellation mechanics, not prose quality. Confirm only that no completed long answer is presented as a successful response; do not add content rules for any partial streamed text."
  ]
}
