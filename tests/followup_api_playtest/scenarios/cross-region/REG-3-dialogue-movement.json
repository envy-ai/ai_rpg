{
  "version": 1,
  "scenario": "cross-region",
  "case": "REG-3-dialogue-movement",
  "description": "A direct travel-prose prompt addresses an origin NPC by alias, returns the canonical accompanying character, and the subsequent authoritative move expands the child destination and moves both actors exactly once.",
  "fixture": "cross-region-alias-companion",
  "configProfile": "cross-region-mechanics",
  "trackedPaths": [
    "player.payload.player.locationId",
    "players.payload.players",
    "locations.payload.locations",
    "calendar.payload.worldTime.timeMinutes"
  ],
  "steps": [
    {
      "type": "loadFixture"
    },
    {
      "type": "snapshot",
      "name": "ready"
    },
    {
      "type": "chat",
      "name": "travel_prose",
      "text": "\"Kuroha, come with me to QA Border Lantern,\" I ask. We leave March Start Marker together now for the short walk, with Kuroha accompanying me for the entire trip and arrival.",
      "travel": true,
      "travelMetadata": {
        "mode": "direct",
        "eventDriven": false,
        "exit": {
          "exitId": "$fixture.entranceToChildExitId",
          "originLocationId": "$fixture.entranceLocationId",
          "direction": "qa_border_lantern",
          "destinationId": "$fixture.childLocationStubId",
          "destinationRegionId": "$fixture.expandedRegionId",
          "destinationIsStub": true,
          "destinationIsRegionEntryStub": false,
          "isVehicle": false,
          "vehicleType": null,
          "destinationName": "QA Border Lantern",
          "regionName": "QA Frost March"
        }
      },
      "interactive": {
        "roll": null,
        "questAccepted": false,
        "confirmed": false
      }
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.travel_prose",
          "path": "payload.authoritativeMovementType",
          "equals": "destination"
        },
        {
          "type": "count",
          "source": "responses.travel_prose",
          "path": "payload.accompanyingCharacters",
          "equals": 1
        },
        {
          "type": "includes",
          "source": "responses.travel_prose",
          "path": "payload.accompanyingCharacters",
          "value": "$fixture.companionName"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "player.payload.player.locationId",
          "equals": "$fixture.entranceLocationId"
        },
        {
          "type": "entityField",
          "source": "after",
          "collection": "players",
          "id": "$fixture.companionId",
          "path": "locationId",
          "equals": "$fixture.entranceLocationId"
        },
        {
          "type": "entityField",
          "source": "after",
          "collection": "locations",
          "id": "$fixture.childLocationStubId",
          "path": "isStub",
          "equals": false
        },
        {
          "type": "exactDelta",
          "path": "calendar.payload.worldTime.timeMinutes",
          "delta": 0,
          "beforeSource": "snapshots.ready",
          "afterSource": "after"
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "player-action",
          "equals": 1,
          "beforeSource": "snapshots.ready",
          "afterSource": "after"
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs"
        }
      ]
    },
    {
      "type": "snapshot",
      "name": "before_move"
    },
    {
      "type": "request",
      "name": "move_together",
      "method": "POST",
      "route": "/api/player/move",
      "body": {
        "destinationId": "$fixture.childLocationStubId",
        "expectedOriginLocationId": "$fixture.entranceLocationId",
        "accompanyingCharacters": "$response.travel_prose.payload.accompanyingCharacters"
      },
      "interactive": {
        "roll": null,
        "questAccepted": false,
        "confirmed": false
      }
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.move_together",
          "path": "payload.success",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.move_together",
          "path": "payload.location.id",
          "equals": "$fixture.childLocationStubId"
        },
        {
          "type": "equals",
          "source": "responses.move_together",
          "path": "payload.location.regionId",
          "equals": "$fixture.expandedRegionId"
        },
        {
          "type": "equals",
          "source": "responses.move_together",
          "path": "payload.location.isStub",
          "equals": false
        },
        {
          "type": "equals",
          "source": "after",
          "path": "player.payload.player.locationId",
          "equals": "$fixture.childLocationStubId"
        },
        {
          "type": "entityField",
          "source": "after",
          "collection": "players",
          "id": "$fixture.companionId",
          "path": "locationId",
          "equals": "$fixture.childLocationStubId"
        },
        {
          "type": "entityField",
          "source": "after",
          "collection": "players",
          "id": "$fixture.companionId",
          "path": "isInPlayerParty",
          "equals": false
        },
        {
          "type": "entityField",
          "source": "after",
          "collection": "locations",
          "id": "$fixture.childLocationStubId",
          "path": "regionId",
          "equals": "$fixture.expandedRegionId"
        },
        {
          "type": "entityField",
          "source": "after",
          "collection": "locations",
          "id": "$fixture.childLocationStubId",
          "path": "isStub",
          "equals": false
        },
        {
          "type": "exactDelta",
          "path": "calendar.payload.worldTime.timeMinutes",
          "delta": 2,
          "beforeSource": "snapshots.before_move",
          "afterSource": "after"
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "event-summary",
          "equals": 1,
          "beforeSource": "snapshots.before_move",
          "afterSource": "after"
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "player-action",
          "equals": 0,
          "beforeSource": "snapshots.before_move",
          "afterSource": "after"
        },
        {
          "type": "includes",
          "source": "after",
          "path": "currentLocation.payload.location.npcIds",
          "value": "$fixture.companionId"
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs"
        }
      ]
    },
    {
      "type": "request",
      "name": "origin_after_move",
      "method": "GET",
      "route": "/api/locations/$fixture.entranceLocationId"
    },
    {
      "type": "request",
      "name": "destination_after_move",
      "method": "GET",
      "route": "/api/locations/$fixture.childLocationStubId"
    },
    {
      "type": "request",
      "name": "region_map",
      "method": "GET",
      "route": "/api/map/region?regionId=$fixture.expandedRegionId"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "notIncludes",
          "source": "responses.origin_after_move",
          "path": "payload.location.npcIds",
          "value": "$fixture.companionId"
        },
        {
          "type": "includes",
          "source": "responses.destination_after_move",
          "path": "payload.location.npcIds",
          "value": "$fixture.companionId"
        },
        {
          "type": "equals",
          "source": "responses.destination_after_move",
          "path": "payload.location.exits.qa_frost_march.destination",
          "equals": "$fixture.entranceLocationId"
        },
        {
          "type": "equals",
          "source": "responses.region_map",
          "path": "payload.region.currentLocationId",
          "equals": "$fixture.childLocationStubId"
        },
        {
          "type": "uniqueBy",
          "source": "responses.region_map",
          "path": "payload.region.locations",
          "key": "id"
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.region_map",
          "path": "payload.region.locations",
          "where": {
            "id": "$fixture.childLocationStubId",
            "regionId": "$fixture.expandedRegionId",
            "isStub": false
          },
          "equals": 1
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs"
        }
      ]
    }
  ],
  "humanReview": [
    "Confirm the travel prose treats Kuroha as QA Quartermaster's alias and depicts her accompanying Baato rather than inventing a second character.",
    "Confirm the prose has one coherent departure/walk/arrival sequence and does not narrate a duplicate location transition; this remains human review only."
  ]
}
