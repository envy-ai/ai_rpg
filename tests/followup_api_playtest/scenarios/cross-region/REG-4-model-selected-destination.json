        },
        {
          "type": "equals",
          "source": "responses.destination_after_travel",
          "path": "payload.location.name",
          "equals": "QA Aurora Cairn"
        },
        {
          "type": "equals",
          "source": "responses.destination_after_travel",
          "path": "payload.location.regionId",
          "equals": "$fixture.expandedRegionId"
        },
        {
          "type": "equals",
          "source": "responses.destination_after_travel",
          "path": "payload.location.exits.march_start_marker.destination",
          "equals": "$fixture.entranceLocationId"
        },
        {
          "type": "equals",
          "source": "responses.destination_after_travel",
          "path": "payload.location.exits.march_start_marker.travelTimeMinutes",
          "equals": 3
        },
        {
          "type": "equals",
          "source": "responses.region_map",
          "path": "payload.region.currentLocationId",
          "equalsFrom": {
            "source": "snapshots.arrived",
            "path": "currentLocation.payload.location.id"
          }
        },
        {
          "type": "uniqueBy",
          "source": "responses.region_map",
          "path": "payload.region.locations",
          "key": "id"
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.region_map",
          "path": "payload.region.locations",
          "where": {
            "name": "QA Aurora Cairn",
            "regionId": "$fixture.expandedRegionId",
            "isStub": false
          },
          "equals": 1
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs"
        }
      ]
    }
  ],
  "humanReview": [
    "Confirm the prose describes one coherent trip from March Start Marker to the newly created QA Aurora Cairn and does not narrate a duplicate move or arrival.",
    "Confirm the generated destination remains a plausible QA Frost March cairn and does not contradict the explicit three-minute route or create a competing destination name."
  ]
}
