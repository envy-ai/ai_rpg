          "equalsFrom": {
            "source": "snapshots.arrived",
            "path": "currentLocation.payload.location.id"
          }
        },
        {
          "type": "equals",
          "source": "responses.origin_after_travel",
          "path": "payload.location.exits.qa_aurora_cairn.destinationRegion",
