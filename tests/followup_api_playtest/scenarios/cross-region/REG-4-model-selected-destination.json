      "interactive": {
        "roll": null,
        "questAccepted": false,
        "confirmed": false
      }
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "absent",
          "source": "responses.create_and_travel",
          "path": "payload.authoritativeMovementType"
        },
        {
          "type": "equals",
          "source": "after",
