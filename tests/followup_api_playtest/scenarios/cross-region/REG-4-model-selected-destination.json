{
  "version": 1,
  "scenario": "cross-region",
  "case": "REG-4-model-selected-destination",
  "description": "A TinyBrain player action selects a named nonexistent location in an existing region without exit-button metadata; the server creates and expands it, creates the route, and commits one authoritative player move.",
  "fixture": "cross-region-expanded-frost-march",
  "configProfile": "cross-region-mechanics",
  "trackedPaths": [
    "player.payload.player.locationId",
    "locations.payload.locations",
    "regions.payload.regions",
    "calendar.payload.worldTime.timeMinutes"
  ],
  "steps": [
    {
      "type": "loadFixture"
    },
    {
      "type": "snapshot",
      "name": "ready"
    },
    {
      "type": "chat",
