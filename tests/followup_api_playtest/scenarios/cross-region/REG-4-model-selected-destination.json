        },
        {
          "type": "equals",
          "source": "after",
          "path": "currentLocation.payload.location.visited",
          "equals": true
        },
        {
          "type": "equals",
          "source": "after",
          "path": "player.payload.player.locationId",
          "equalsFrom": {
            "source": "after",
            "path": "currentLocation.payload.location.id"
          }
        },
        {
          "type": "arrayObjectCount",
          "source": "after",
          "path": "locations.payload.locations",
          "where": {
            "name": "QA Aurora Cairn",
            "regionId": "$fixture.expandedRegionId",
            "isStub": false
          },
          "equals": 1
        },
        {
          "type": "exactDelta",
          "path": "calendar.payload.worldTime.timeMinutes",
          "delta": 3,
          "beforeSource": "snapshots.ready",
          "afterSource": "after"
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "player-action",
          "equals": 1,
          "beforeSource": "snapshots.ready",
          "afterSource": "after"
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "event-summary",
          "equals": 1,
          "beforeSource": "snapshots.ready",
          "afterSource": "after"
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs"
        }
      ]
    },
    {
      "type": "snapshot",
      "name": "arrived"
    },
    {
      "type": "request",
      "name": "origin_after_travel",
      "method": "GET",
      "route": "/api/locations/$fixture.entranceLocationId"
    },
    {
      "type": "request",
      "name": "destination_after_travel",
      "method": "GET",
      "route": "/api/locations/$snapshot.arrived.currentLocation.payload.location.id"
    },
    {
      "type": "request",
      "name": "region_map",
      "method": "GET",
      "route": "/api/map/region?regionId=$fixture.expandedRegionId"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.origin_after_travel",
