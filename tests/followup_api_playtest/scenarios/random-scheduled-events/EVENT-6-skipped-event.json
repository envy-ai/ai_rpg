{
  "version": 1,
  "scenario": "random-scheduled-events",
  "case": "EVENT-6-skipped-event",
  "description": "Delete both named entities required by the minute-665 bell event before it is due, then prove validated negative applicability marks only that event skipped without mutation, prose, or history.",
  "fixture": "random-scheduled-events",
