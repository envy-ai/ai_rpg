{
  "version": 1,
  "scenario": "stealth-hidden",
  "case": "HIDE-2-explicit-search-success",
  "description": "An explicit forced-high search must resolve exactly one player perception versus scout hiding check, reveal the canonical hidden NPC only after success, and request a location refresh.",
  "fixture": "stealth-hidden-npcs",
  "configProfile": "stealth-hidden-mechanics",
  "trackedPaths": [
    "player.payload.player.locationId",
    "players.payload.players",
    "currentLocation.payload.location.npcIds",
    "history.payload",
    "calendar.payload.worldTime.timeMinutes"
  ],
  "steps": [
    {
      "type": "loadFixture"
    },
    {
      "type": "request",
      "name": "make_player_search_certain_to_succeed",
      "method": "PUT",
      "route": "/api/npcs/$fixture.playerId",
      "body": {
        "attributes": {
          "wisdom": 20
        },
        "skills": {
          "Perception": 20
        }
      }
    },
    {
      "type": "request",
      "name": "make_scout_hiding_certain_to_lose",
      "method": "PUT",
      "route": "/api/npcs/$fixture.scoutId",
      "body": {
        "hiddenFromPlayer": true,
        "attributes": {
          "dexterity": 1
        },
        "skills": {
          "Stealth": 0
        }
      }
    },
    {
      "type": "request",
      "name": "isolate_decoy",
      "method": "POST",
      "route": "/api/npcs/$fixture.decoyId/teleport",
      "body": {
        "locationId": "$fixture.isolationLocationId",
        "accountTravelTime": false
      }
    },
    {
      "type": "request",
      "name": "isolate_courier",
      "method": "POST",
      "route": "/api/npcs/char_37/teleport",
      "body": {
        "locationId": "$fixture.isolationLocationId",
        "accountTravelTime": false
      }
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.make_player_search_certain_to_succeed",
          "path": "payload.npc.attributes.wisdom",
          "equals": 20
        },
        {
          "type": "equals",
          "source": "responses.make_player_search_certain_to_succeed",
          "path": "payload.npc.skills.Perception",
          "equals": 20
        },
        {
          "type": "equals",
          "source": "responses.make_scout_hiding_certain_to_lose",
          "path": "payload.npc.hiddenFromPlayer",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.make_scout_hiding_certain_to_lose",
          "path": "payload.npc.attributes.dexterity",
          "equals": 1
        },
        {
          "type": "equals",
          "source": "responses.make_scout_hiding_certain_to_lose",
          "path": "payload.npc.skills.Stealth",
          "equals": 0
        },
        {
          "type": "entityField",
          "source": "after",
          "collection": "players",
          "id": "$fixture.decoyId",
          "path": "locationId",
          "equals": "$fixture.isolationLocationId"
        },
        {
          "type": "entityField",
          "source": "after",
          "collection": "players",
          "id": "char_37",
          "path": "locationId",
          "equals": "$fixture.isolationLocationId"
        },
        {
          "type": "entityField",
          "source": "after",
          "collection": "players",
          "id": "$fixture.scoutId",
          "path": "locationId",
          "equals": "$fixture.baselineLocationId"
        },
        {
          "type": "entityField",
          "source": "after",
          "collection": "players",
          "id": "$fixture.scoutId",
          "path": "hiddenFromPlayer",
          "equals": true
        }
      ]
    },
    {
      "type": "snapshot",
      "name": "before_explicit_search"
    },
    {
      "type": "chat",
      "name": "explicit_search",
      "text": "I deliberately search March Start Marker for the concealed scout known as Whisper. <f> This is one careful perception-versus-hiding attempt. If and only if the opposed check succeeds, I spot and reveal that exact person. I do not move, attack, use an item, or perform any second action.",
      "travel": false,
      "interactive": {
        "roll": 20,
        "questAccepted": false,
        "confirmed": false
      }
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "count",
          "source": "responses.explicit_search",
          "path": "payload.toolInvocations",
          "equals": 1
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.explicit_search",
          "path": "payload.toolInvocations",
          "where": {
            "name": "resolveOpposedSkillCheck",
            "metadata": {
              "actor": "player",
              "opponent": "$fixture.scoutName",
              "actionResolution": {
                "success": true,
                "roll": {
                  "die": 20
                },
                "opponent": {
                  "id": "$fixture.scoutId",
                  "name": "$fixture.scoutName"
                }
              }
            }
          },
          "equals": 1
        },
        {
          "type": "equals",
          "source": "responses.explicit_search",
          "path": "payload.checkResultsRecorded",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.explicit_search",
          "path": "payload.locationRefreshRequested",
          "equals": true
        },
        {
          "type": "entityField",
          "source": "after",
          "collection": "players",
          "id": "$fixture.scoutId",
          "path": "hiddenFromPlayer",
          "equals": false
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "check-results",
          "equals": 1,
          "beforeSource": "snapshots.before_explicit_search",
          "afterSource": "after"
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "player-action",
          "equals": 1,
          "beforeSource": "snapshots.before_explicit_search",
          "afterSource": "after"
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "event-summary",
          "equals": 1,
          "beforeSource": "snapshots.before_explicit_search",
          "afterSource": "after"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "player.payload.player.locationId",
          "equals": "$fixture.baselineLocationId"
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs"
        }
      ]
    }
  ],
  "humanReview": [
    "The player-action prose should describe the one successful search and reveal QA Veiled Scout/Whisper only after the recorded opposed result, without adding movement, combat, item use, or a second action."
  ]
}
