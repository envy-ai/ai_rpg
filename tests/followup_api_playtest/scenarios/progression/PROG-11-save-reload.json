{
  "version": 1,
  "scenario": "progression",
  "case": "PROG-11-save-reload",
  "description": "Reuse a disposable copy of the cached level-4 options fixture, complete level 4, generate and save a level-5 pending draft, deliberately consume that draft in runtime state, then reload and prove completed abilities, declines, and the exact pending draft hydrate without regeneration drift.",
  "fixture": "progression-level4-options",
  "configProfile": "progression-mechanics",
  "trackedPaths": [
    "player.payload.player",
    "players.payload.players",
    "locations.payload.locations",
    "things.payload.things",
    "factions.payload.factions",
    "factions.payload.playerStandings",
    "scheduledEvents.payload.scheduledEvents",
    "calendar.payload.worldTime",
    "history.payload.history"
  ],
  "steps": [
    {
      "type": "loadFixture"
    },
    {
      "type": "snapshot",
      "name": "fixture_baseline"
    },
    {
      "type": "request",
      "name": "cached_level4",
      "method": "GET",
      "route": "/api/player/ability-selection?generateOptions=false"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.cached_level4",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.cached_level4",
          "path": "payload.abilitySelection.selection.level",
          "equals": 4
        },
        {
          "type": "equals",
          "source": "responses.cached_level4",
          "path": "payload.abilitySelection.selection.optionsReady",
          "equals": true
        },
        {
          "type": "count",
          "source": "responses.cached_level4",
          "path": "payload.abilitySelection.selection.options",
          "equals": 6
        },
        {
          "type": "uniqueBy",
          "source": "responses.cached_level4",
          "path": "payload.abilitySelection.selection.options",
          "key": "name"
        },
        {
          "type": "equals",
          "source": "responses.cached_level4",
          "path": "payload.abilitySelection.selection.options.0.name",
          "equals": "$fixture.generatedOptionNames.0"
        },
        {
          "type": "equals",
          "source": "responses.cached_level4",
          "path": "payload.abilitySelection.selection.options.5.name",
          "equals": "$fixture.generatedOptionNames.5"
        }
      ]
    },
    {
      "type": "request",
      "name": "submit_level4",
      "method": "POST",
      "route": "/api/player/ability-selection/submit",
      "body": {
        "level": 4,
        "selectedAbilityNames": [
          "$fixture.generatedOptionNames.0",
          "$fixture.generatedOptionNames.1",
          "$fixture.generatedOptionNames.2"
        ],
        "declinedAbilityNames": [
          "$fixture.generatedOptionNames.3",
          "$fixture.generatedOptionNames.4",
          "$fixture.generatedOptionNames.5"
        ]
      }
    },
    {
      "type": "request",
      "name": "level_to_five",
      "method": "POST",
      "route": "/api/player/levelup",
      "body": {}
    },
    {
      "type": "request",
      "name": "generate_level5",
      "method": "GET",
      "route": "/api/player/ability-selection"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.submit_level4",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.level_to_five",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.generate_level5",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.generate_level5",
          "path": "payload.pending",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.generate_level5",
          "path": "payload.player.level",
          "equals": 5
        },
        {
          "type": "count",
          "source": "responses.generate_level5",
          "path": "payload.player.abilities",
          "equals": 12
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.generate_level5",
          "path": "payload.player.abilities",
          "where": {
            "level": 4
          },
          "equals": 3
        },
        {
          "type": "equals",
          "source": "responses.generate_level5",
          "path": "payload.abilitySelection.selection.level",
          "equals": 5
        },
        {
          "type": "equals",
          "source": "responses.generate_level5",
          "path": "payload.abilitySelection.selection.requiredSelections",
          "equals": 3
        },
        {
          "type": "equals",
          "source": "responses.generate_level5",
          "path": "payload.abilitySelection.selection.optionsReady",
          "equals": true
        },
        {
          "type": "count",
          "source": "responses.generate_level5",
          "path": "payload.abilitySelection.selection.options",
          "equals": 6
        },
        {
          "type": "uniqueBy",
          "source": "responses.generate_level5",
          "path": "payload.abilitySelection.selection.options",
          "key": "name"
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.generate_level5",
          "path": "payload.abilitySelection.selection.options",
          "where": {
            "level": 5
          },
          "equals": 6
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "level-up",
          "equals": 1,
          "beforeSource": "snapshots.fixture_baseline",
          "afterSource": "after"
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "player-action",
          "equals": 0,
          "beforeSource": "snapshots.fixture_baseline",
          "afterSource": "after"
        }
      ]
    },
    {
      "type": "request",
      "name": "pending_before_save",
      "method": "GET",
      "route": "/api/player/ability-selection?generateOptions=false"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.pending_before_save",
          "path": "payload.abilitySelection",
          "equalsFrom": {
            "source": "responses.generate_level5",
            "path": "payload.abilitySelection"
          }
        },
        {
          "type": "equals",
          "source": "responses.pending_before_save",
          "path": "payload.player.abilities",
          "equalsFrom": {
            "source": "responses.generate_level5",
            "path": "payload.player.abilities"
          }
        }
      ]
    },
    {
      "type": "save",
      "name": "pending_level5_save"
    },
    {
      "type": "snapshot",
      "name": "saved_progression"
    },
    {
      "type": "readSavedJson",
      "name": "saved_raw_players",
      "saveName": "$response.pending_level5_save.payload.saveName",
      "fileName": "allPlayers.json"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.saved_raw_players",
          "path": "payload.char_2.level",
          "equals": 5
        },
        {
          "type": "count",
          "source": "responses.saved_raw_players",
          "path": "payload.char_2.abilities",
          "equals": 12
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.saved_raw_players",
          "path": "payload.char_2.abilities",
          "where": {
            "level": 4
          },
          "equals": 3
        },
        {
          "type": "count",
          "source": "responses.saved_raw_players",
          "path": "payload.char_2.declinedAbilities",
          "equals": 3
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.saved_raw_players",
          "path": "payload.char_2.declinedAbilities",
          "where": {
            "name": "$fixture.generatedOptionNames.3",
            "level": 4
          },
          "equals": 1
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.saved_raw_players",
          "path": "payload.char_2.declinedAbilities",
          "where": {
            "name": "$fixture.generatedOptionNames.4",
            "level": 4
          },
          "equals": 1
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.saved_raw_players",
          "path": "payload.char_2.declinedAbilities",
          "where": {
            "name": "$fixture.generatedOptionNames.5",
            "level": 4
          },
          "equals": 1
        },
        {
          "type": "equals",
          "source": "responses.saved_raw_players",
          "path": "payload.char_2.pendingAbilityOptionsByLevel.5",
          "equalsFrom": {
            "source": "responses.generate_level5",
            "path": "payload.abilitySelection.selection.options"
          }
        }
      ]
    },
    {
      "type": "request",
      "name": "consume_level5_after_save",
      "method": "POST",
      "route": "/api/player/ability-selection/submit",
      "body": {
        "level": 5,
        "selectedAbilityNames": [
          "$response.generate_level5.payload.abilitySelection.selection.options.0.name",
          "$response.generate_level5.payload.abilitySelection.selection.options.1.name",
          "$response.generate_level5.payload.abilitySelection.selection.options.2.name"
        ],
        "declinedAbilityNames": [
          "$response.generate_level5.payload.abilitySelection.selection.options.3.name",
          "$response.generate_level5.payload.abilitySelection.selection.options.4.name",
          "$response.generate_level5.payload.abilitySelection.selection.options.5.name"
        ]
      }
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.consume_level5_after_save",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.consume_level5_after_save",
          "path": "payload.pending",
          "equals": false
        },
        {
          "type": "count",
          "source": "responses.consume_level5_after_save",
          "path": "payload.player.abilities",
          "equals": 15
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.consume_level5_after_save",
          "path": "payload.player.abilities",
          "where": {
            "level": 5
          },
          "equals": 3
        },
        {
          "type": "count",
          "source": "responses.consume_level5_after_save",
          "path": "payload.abilitySelection.levelsMissing",
          "equals": 0
        },
        {
          "type": "notEquals",
          "source": "after",
          "path": "player.payload.player.abilities",
          "equalsFrom": {
            "source": "snapshots.saved_progression",
            "path": "player.payload.player.abilities"
          }
        }
      ]
    },
    {
      "type": "reload",
      "name": "reload_pending_level5",
      "saveName": "$response.pending_level5_save.payload.saveName"
    },
    {
      "type": "request",
      "name": "hydrated_pending",
      "method": "GET",
      "route": "/api/player/ability-selection?generateOptions=false"
    },
    {
      "type": "request",
      "name": "hydrated_cached_read",
      "method": "GET",
      "route": "/api/player/ability-selection"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.reload_pending_level5",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.reload_pending_level5",
          "path": "payload.success",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.hydrated_pending",
          "path": "payload.pending",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.hydrated_pending",
          "path": "payload.player.level",
          "equals": 5
        },
        {
          "type": "equals",
          "source": "responses.hydrated_pending",
          "path": "payload.player.abilities",
          "equalsFrom": {
            "source": "responses.pending_before_save",
            "path": "payload.player.abilities"
          }
        },
        {
          "type": "equals",
          "source": "responses.hydrated_pending",
          "path": "payload.abilitySelection",
          "equalsFrom": {
            "source": "responses.pending_before_save",
            "path": "payload.abilitySelection"
          }
        },
        {
          "type": "equals",
          "source": "responses.hydrated_cached_read",
          "path": "payload.abilitySelection",
          "equalsFrom": {
            "source": "responses.pending_before_save",
            "path": "payload.abilitySelection"
          }
        },
        {
          "type": "equals",
          "source": "responses.hydrated_cached_read",
          "path": "payload.player.abilities",
          "equalsFrom": {
            "source": "responses.pending_before_save",
            "path": "payload.player.abilities"
          }
        },
        {
          "type": "stateUnchanged",
          "beforeSource": "snapshots.saved_progression",
          "afterSource": "after",
          "paths": [
            "player.payload.player.level",
            "player.payload.player.health",
            "player.payload.player.maxHealth",
            "player.payload.player.locationId",
            "player.payload.player.experience",
            "player.payload.player.abilities",
            "player.payload.player.inventory",
            "player.payload.player.currency",
            "player.payload.player.attributes",
            "player.payload.player.skills",
            "player.payload.player.statusEffects",
            "locations.payload.locations",
            "things.payload.things",
            "factions.payload.factions",
            "factions.payload.playerStandings",
            "scheduledEvents.payload.scheduledEvents",
            "calendar.payload.worldTime",
            "history.payload.history"
          ]
        }
      ]
    },
    {
      "type": "save",
      "name": "rehydrated_state_save"
    },
    {
      "type": "readSavedJson",
      "name": "rehydrated_raw_players",
      "saveName": "$response.rehydrated_state_save.payload.saveName",
      "fileName": "allPlayers.json"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.rehydrated_raw_players",
          "path": "payload.char_2.level",
          "equalsFrom": {
            "source": "responses.saved_raw_players",
            "path": "payload.char_2.level"
          }
        },
        {
          "type": "equals",
          "source": "responses.rehydrated_raw_players",
          "path": "payload.char_2.abilities",
          "equalsFrom": {
            "source": "responses.saved_raw_players",
            "path": "payload.char_2.abilities"
          }
        },
        {
          "type": "equals",
          "source": "responses.rehydrated_raw_players",
          "path": "payload.char_2.declinedAbilities",
          "equalsFrom": {
            "source": "responses.saved_raw_players",
            "path": "payload.char_2.declinedAbilities"
          }
        },
        {
          "type": "equals",
          "source": "responses.rehydrated_raw_players",
          "path": "payload.char_2.pendingAbilityOptionsByLevel",
          "equalsFrom": {
            "source": "responses.saved_raw_players",
            "path": "payload.char_2.pendingAbilityOptionsByLevel"
          }
        },
        {
          "type": "uniqueBy",
          "source": "after",
          "path": "players.payload.players",
          "key": "id"
        },
        {
          "type": "uniqueBy",
          "source": "after",
          "path": "locations.payload.locations",
          "key": "id"
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs"
        }
      ]
    }
  ],
  "humanReview": [
    "Review only the newly generated level-5 ability-card set for broad coherence and semantic diversity. Record any quality issue with the full cards under the existing PROSE-005 issue rather than adding one-response prompt restrictions or prose heuristics.",
    "Confirm the save/reload result is evaluated mechanically: exact completed level-4 cards, exact private declines, and byte-identical cached level-5 options must return after runtime consumption, and the post-reload default GET must not require another generation."
  ]
}
