{
  "version": 1,
  "scenario": "progression",
  "case": "PROG-6-partial-preselection",
  "description": "Generate only five new cards around one existing level-4 preselection, then omit that preselection from the submitted three choices and prove it is replaced atomically and persisted as declined.",
  "fixture": "progression-level4-preselected",
  "configProfile": "progression-mechanics",
  "trackedPaths": [
    "player.payload.player",
    "players.payload.players",
    "locations.payload.locations",
    "things.payload.things",
    "factions.payload.factions",
    "factions.payload.playerStandings",
    "scheduledEvents.payload.scheduledEvents",
    "calendar.payload.worldTime",
    "history.payload.history"
  ],
  "steps": [
    {
      "type": "loadFixture"
    },
    {
      "type": "snapshot",
      "name": "before_generation"
    },
    {
      "type": "request",
      "name": "generate_partial_level4",
      "method": "GET",
      "route": "/api/player/ability-selection"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.generate_partial_level4",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.generate_partial_level4",
          "path": "payload.pending",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.generate_partial_level4",
          "path": "payload.abilitySelection.selection.level",
          "equals": 4
        },
        {
          "type": "equals",
          "source": "responses.generate_partial_level4",
          "path": "payload.abilitySelection.selection.requiredSelections",
          "equals": 3
        },
        {
          "type": "equals",
          "source": "responses.generate_partial_level4",
          "path": "payload.abilitySelection.selection.optionsPerLevel",
          "equals": 6
        },
        {
          "type": "equals",
          "source": "responses.generate_partial_level4",
          "path": "payload.abilitySelection.selection.optionsReady",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.generate_partial_level4",
          "path": "payload.abilitySelection.selection.optionsToGenerate",
          "equals": 5
        },
        {
          "type": "count",
          "source": "responses.generate_partial_level4",
          "path": "payload.abilitySelection.selection.options",
          "equals": 6
        },
        {
          "type": "uniqueBy",
          "source": "responses.generate_partial_level4",
          "path": "payload.abilitySelection.selection.options",
          "key": "name"
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.generate_partial_level4",
          "path": "payload.abilitySelection.selection.options",
          "where": {
            "level": 4
          },
          "equals": 6
        },
        {
          "type": "equals",
          "source": "responses.generate_partial_level4",
          "path": "payload.abilitySelection.selection.options.0",
          "equals": {
            "name": "$fixture.preselectedAbilityName",
            "description": "Baato keeps one stable catalyst prepared for routine alchemical work.",
            "shortDescription": "Keeps a stable catalyst ready for routine alchemy.",
            "type": "Passive",
            "level": 4
          }
        },
        {
          "type": "equals",
          "source": "responses.generate_partial_level4",
          "path": "payload.abilitySelection.selection.preselectedAbilityNames",
          "equals": [
            "$fixture.preselectedAbilityName"
          ]
        },
        {
          "type": "count",
          "source": "responses.generate_partial_level4",
          "path": "payload.player.abilities",
          "equals": 10
        },
        {
          "type": "equals",
          "source": "responses.generate_partial_level4",
          "path": "payload.player.abilities",
          "equalsFrom": {
            "source": "snapshots.before_generation",
            "path": "player.payload.player.abilities"
          }
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "player-action",
          "equals": 0,
          "beforeSource": "snapshots.before_generation",
          "afterSource": "after"
        }
      ]
    },
    {
      "type": "request",
      "name": "read_cached_partial",
      "method": "GET",
      "route": "/api/player/ability-selection"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.read_cached_partial",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.read_cached_partial",
          "path": "payload.abilitySelection",
          "equalsFrom": {
            "source": "responses.generate_partial_level4",
            "path": "payload.abilitySelection"
          }
        }
      ]
    },
    {
      "type": "request",
      "name": "replace_preselection",
      "method": "POST",
      "route": "/api/player/ability-selection/submit",
      "body": {
        "level": 4,
        "selectedAbilityNames": [
          "$response.generate_partial_level4.payload.abilitySelection.selection.options.1.name",
          "$response.generate_partial_level4.payload.abilitySelection.selection.options.2.name",
          "$response.generate_partial_level4.payload.abilitySelection.selection.options.3.name"
        ],
        "declinedAbilityNames": [
          "$response.generate_partial_level4.payload.abilitySelection.selection.options.0.name",
          "$response.generate_partial_level4.payload.abilitySelection.selection.options.4.name",
          "$response.generate_partial_level4.payload.abilitySelection.selection.options.5.name"
        ]
      }
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.replace_preselection",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.replace_preselection",
          "path": "payload.pending",
          "equals": false
        },
        {
          "type": "equals",
          "source": "responses.replace_preselection",
          "path": "payload.abilitySelection.pending",
          "equals": false
        },
        {
          "type": "count",
          "source": "responses.replace_preselection",
          "path": "payload.player.abilities",
          "equals": 12
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.replace_preselection",
          "path": "payload.player.abilities",
          "where": {
            "level": 4
          },
          "equals": 3
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.replace_preselection",
          "path": "payload.player.abilities",
          "where": {
            "name": "$fixture.preselectedAbilityName"
          },
          "equals": 0
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.replace_preselection",
          "path": "payload.player.abilities",
          "where": {
            "name": "$response.generate_partial_level4.payload.abilitySelection.selection.options.1.name",
            "level": 4
          },
          "equals": 1
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.replace_preselection",
          "path": "payload.player.abilities",
          "where": {
            "name": "$response.generate_partial_level4.payload.abilitySelection.selection.options.2.name",
            "level": 4
          },
          "equals": 1
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.replace_preselection",
          "path": "payload.player.abilities",
          "where": {
            "name": "$response.generate_partial_level4.payload.abilitySelection.selection.options.3.name",
            "level": 4
          },
          "equals": 1
        },
        {
          "type": "stateUnchanged",
          "beforeSource": "snapshots.before_generation",
          "afterSource": "after",
          "paths": [
            "player.payload.player.level",
            "player.payload.player.health",
            "player.payload.player.maxHealth",
            "player.payload.player.locationId",
            "player.payload.player.experience",
            "player.payload.player.inventory",
            "player.payload.player.currency",
            "player.payload.player.attributes",
            "player.payload.player.skills",
            "player.payload.player.statusEffects",
            "locations.payload.locations",
            "things.payload.things",
            "factions.payload.factions",
            "factions.payload.playerStandings",
            "scheduledEvents.payload.scheduledEvents",
            "calendar.payload.worldTime",
            "history.payload.history"
          ]
        }
      ]
    },
    {
      "type": "save",
      "name": "replaced_preselection_save"
    },
    {
      "type": "readSavedJson",
      "name": "raw_players",
      "fileName": "allPlayers.json"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "count",
          "source": "responses.raw_players",
          "path": "payload.char_2.declinedAbilities",
          "equals": 3
        },
        {
          "type": "arrayObjectCount",
          "source": "responses.raw_players",
          "path": "payload.char_2.declinedAbilities",
          "where": {
            "name": "$fixture.preselectedAbilityName",
            "description": "Baato keeps one stable catalyst prepared for routine alchemical work.",
            "shortDescription": "Keeps a stable catalyst ready for routine alchemy.",
            "type": "Passive",
            "level": 4
          },
          "equals": 1
        },
        {
          "type": "equals",
          "source": "responses.raw_players",
          "path": "payload.char_2.pendingAbilityOptionsByLevel",
          "equals": {}
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "player-action",
          "equals": 0,
          "beforeSource": "snapshots.before_generation",
          "afterSource": "after"
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs",
          "allowedPrefixes": [
            "ERROR_chatCompletionError_player_ability_options_"
          ]
        }
      ]
    }
  ],
  "humanReview": [
    "Review the five newly generated cards for coherent, setting-compatible Alchemist options; record semantic similarity or prose quality issues in tmp/prose_issues_log.md rather than changing prompt rules for this case."
  ]
}
