{
  "version": 1,
  "scenario": "progression-setup",
  "case": "PROG-fixture-level4-pending",
  "description": "Derive one reusable level-4 pending-selection fixture from a disposable copy of the immutable level-3 fast-travel fixture, without generating cards, creating entities, or changing the source.",
  "fixture": "fast-travel-visited-favorites",
  "configProfile": "progression-mechanics",
  "trackedPaths": [
    "player.payload.player",
    "players.payload.players",
    "locations.payload.locations",
    "things.payload.things",
    "factions.payload.factions",
    "factions.payload.playerStandings",
    "scheduledEvents.payload.scheduledEvents",
    "calendar.payload.worldTime",
    "history.payload.history"
  ],
  "steps": [
    {
      "type": "loadFixture"
    },
    {
      "type": "snapshot",
      "name": "before_setup"
    },
    {
      "type": "request",
      "name": "level_to_pending_four",
      "method": "POST",
      "route": "/api/player/levelup",
      "body": {}
    },
    {
      "type": "request",
      "name": "pending_state",
      "method": "GET",
      "route": "/api/player/ability-selection?generateOptions=false"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.level_to_pending_four",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.level_to_pending_four",
          "path": "payload.player.level",
          "equals": 4
        },
        {
          "type": "equals",
          "source": "responses.level_to_pending_four",
          "path": "payload.player.health",
          "equals": 45
        },
        {
          "type": "equals",
          "source": "responses.level_to_pending_four",
          "path": "payload.player.maxHealth",
          "equals": 45
        },
        {
          "type": "equals",
          "source": "responses.level_to_pending_four",
          "path": "payload.player.abilities",
          "equalsFrom": {
            "source": "snapshots.before_setup",
            "path": "player.payload.player.abilities"
          }
        },
        {
          "type": "equals",
          "source": "responses.pending_state",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.pending_state",
          "path": "payload.pending",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.pending_state",
          "path": "payload.abilitySelection.currentLevel",
          "equals": 4
        },
        {
          "type": "equals",
          "source": "responses.pending_state",
          "path": "payload.abilitySelection.levelsMissing",
          "equals": [
            4
          ]
        },
        {
          "type": "equals",
          "source": "responses.pending_state",
          "path": "payload.abilitySelection.selection",
          "equals": {
            "level": 4,
            "requiredSelections": 3,
            "optionsPerLevel": 6,
            "optionsReady": false,
            "optionsToGenerate": 6,
            "options": [],
            "preselectedAbilityNames": []
          }
        },
        {
          "type": "exactDelta",
          "beforeSource": "snapshots.before_setup",
          "afterSource": "after",
          "path": "player.payload.player.level",
          "delta": 1
        },
        {
          "type": "historyAddedSequence",
          "entryTypes": [
            "level-up"
          ],
          "expected": [
            {
              "type": "level-up",
              "metadata": {
                "excludeFromBaseContextHistory": true,
                "levelUp": {
                  "characterId": "$fixture.playerId",
                  "previousLevel": 3,
                  "newLevel": 4
                }
              }
            }
          ],
          "beforeSource": "snapshots.before_setup",
          "afterSource": "after"
        },
        {
          "type": "stateUnchanged",
          "beforeSource": "snapshots.before_setup",
          "afterSource": "after",
          "paths": [
            "player.payload.player.locationId",
            "player.payload.player.experience",
            "player.payload.player.inventory",
            "player.payload.player.currency",
            "player.payload.player.attributes",
            "player.payload.player.skills",
            "player.payload.player.statusEffects",
            "player.payload.player.abilities",
            "locations.payload.locations",
            "things.payload.things",
            "factions.payload.factions",
            "factions.payload.playerStandings",
            "scheduledEvents.payload.scheduledEvents",
            "calendar.payload.worldTime"
          ]
        }
      ]
    },
    {
      "type": "save",
      "name": "fixture_save"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.fixture_save",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.fixture_save",
          "path": "payload.success",
          "equals": true
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs"
        }
      ]
    }
  ],
  "humanReview": [
    "Fixture setup only: confirm the source fixture was copied, all progression changes used deterministic endpoints, no entity was generated, and no model completion ran."
  ]
}
