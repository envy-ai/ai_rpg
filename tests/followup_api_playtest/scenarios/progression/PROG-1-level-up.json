{
  "version": 1,
  "scenario": "progression",
  "case": "PROG-1-level-up",
  "description": "On a fresh disposable copy of the existing level-3 Baato fixture, use the real player level-up endpoint and verify the level/health/history transition plus pending level-4 ability selection without generating options or assigning abilities.",
  "fixture": "fast-travel-visited-favorites",
  "configProfile": "progression-mechanics",
  "trackedPaths": [
    "player.payload.player",
    "players.payload.players",
    "locations.payload.locations",
    "things.payload.things",
    "factions.payload.factions",
    "factions.payload.playerStandings",
    "scheduledEvents.payload.scheduledEvents",
    "calendar.payload.worldTime",
    "history.payload.history"
  ],
  "steps": [
    {
      "type": "loadFixture"
    },
    {
      "type": "request",
      "name": "initial_selection_state",
      "method": "GET",
      "route": "/api/player/ability-selection?generateOptions=false"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.initial_selection_state",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.initial_selection_state",
          "path": "payload.pending",
          "equals": false
        },
        {
          "type": "equals",
          "source": "responses.initial_selection_state",
          "path": "payload.abilitySelection.levelsMissing",
          "equals": []
        },
        {
          "type": "equals",
          "source": "responses.initial_selection_state",
          "path": "payload.player.level",
          "equals": 3
        },
        {
          "type": "count",
          "source": "responses.initial_selection_state",
          "path": "payload.player.abilities",
          "equals": 9
        }
      ]
    },
    {
      "type": "snapshot",
      "name": "before_level_up"
    },
    {
      "type": "request",
      "name": "level_up",
      "method": "POST",
      "route": "/api/player/levelup",
      "body": {}
    },
    {
      "type": "request",
      "name": "pending_without_generation",
      "method": "GET",
      "route": "/api/player/ability-selection?generateOptions=false"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.success",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.player.level",
          "equals": 4
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.player.health",
          "equalsFrom": {
            "source": "responses.level_up",
            "path": "payload.player.maxHealth"
          }
        },
        {
          "type": "greaterThan",
          "source": "responses.level_up",
          "path": "payload.player.maxHealth",
          "valueFrom": {
            "source": "snapshots.before_level_up",
            "path": "player.payload.player.maxHealth"
          }
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.player.abilities",
          "equalsFrom": {
            "source": "snapshots.before_level_up",
            "path": "player.payload.player.abilities"
          }
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.pendingAbilitySelection.pending",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.pendingAbilitySelection.currentLevel",
          "equals": 4
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.pendingAbilitySelection.requiredPerLevel",
          "equals": 3
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.pendingAbilitySelection.optionsPerLevel",
          "equals": 6
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.pendingAbilitySelection.levelsMissing",
          "equals": [
            4
          ]
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.pendingAbilitySelection.selection.level",
          "equals": 4
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.pendingAbilitySelection.selection.requiredSelections",
          "equals": 3
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.pendingAbilitySelection.selection.optionsReady",
          "equals": false
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.pendingAbilitySelection.selection.optionsToGenerate",
          "equals": 6
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.pendingAbilitySelection.selection.options",
          "equals": []
        },
        {
          "type": "equals",
          "source": "responses.level_up",
          "path": "payload.pendingAbilitySelection.selection.preselectedAbilityNames",
          "equals": []
        },
        {
          "type": "equals",
          "source": "responses.pending_without_generation",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.pending_without_generation",
          "path": "payload.pending",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.pending_without_generation",
          "path": "payload.abilitySelection",
          "equalsFrom": {
            "source": "responses.level_up",
            "path": "payload.pendingAbilitySelection"
          }
        },
        {
          "type": "equals",
          "source": "responses.pending_without_generation",
          "path": "payload.player.abilities",
          "equalsFrom": {
            "source": "snapshots.before_level_up",
            "path": "player.payload.player.abilities"
          }
        },
        {
          "type": "exactDelta",
          "beforeSource": "snapshots.before_level_up",
          "afterSource": "after",
          "path": "player.payload.player.level",
          "delta": 1
        },
        {
          "type": "equals",
          "source": "after",
          "path": "player.payload.player.health",
          "equalsFrom": {
            "source": "after",
            "path": "player.payload.player.maxHealth"
          }
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "level-up",
          "equals": 1,
          "beforeSource": "snapshots.before_level_up",
          "afterSource": "after"
        },
        {
          "type": "historyAddedSequence",
          "entryTypes": [
            "level-up"
          ],
          "expected": [
            {
              "type": "level-up",
              "metadata": {
                "excludeFromBaseContextHistory": true,
                "levelUp": {
                  "characterId": "$fixture.playerId",
                  "previousLevel": 3,
                  "newLevel": 4
                }
              }
            }
          ],
          "beforeSource": "snapshots.before_level_up",
          "afterSource": "after"
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "player-action",
          "equals": 0,
          "beforeSource": "snapshots.before_level_up",
          "afterSource": "after"
        },
        {
          "type": "stateUnchanged",
          "beforeSource": "snapshots.before_level_up",
          "afterSource": "after",
          "paths": [
            "player.payload.player.locationId",
            "player.payload.player.experience",
            "player.payload.player.inventory",
            "player.payload.player.currency",
            "player.payload.player.attributes",
            "player.payload.player.skills",
            "player.payload.player.statusEffects",
            "player.payload.player.abilities",
            "locations.payload.locations",
            "things.payload.things",
            "factions.payload.factions",
            "factions.payload.playerStandings",
            "scheduledEvents.payload.scheduledEvents",
            "calendar.payload.worldTime"
          ]
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs"
        }
      ]
    }
  ],
  "humanReview": [
    "This state-only case has no prose. Confirm the level-up endpoint does not request model-generated ability cards or silently assign abilities before the explicit selection endpoint is called with generation enabled."
  ]
}
