          "type": "exactDelta",
          "beforeSource": "snapshots.before_skill_spend",
          "afterSource": "after",
          "path": "player.payload.player.skills.Alchemy",
          "delta": 1
        },
        {
          "type": "exactDelta",
          "beforeSource": "snapshots.before_skill_spend",
          "afterSource": "after",
          "path": "player.payload.player.unspentSkillPoints",
          "delta": -1
        },
        {
          "type": "stateUnchanged",
          "beforeSource": "snapshots.before_skill_spend",
          "afterSource": "after",
          "paths": [
            "player.payload.player.level",
            "player.payload.player.experience",
            "player.payload.player.attributes",
            "player.payload.player.abilities",
            "player.payload.player.declinedAbilities",
            "player.payload.player.pendingAbilityOptionsByLevel",
            "player.payload.player.locationId",
            "locations.payload.locations",
            "things.payload.things",
            "factions.payload.factions",
            "factions.payload.playerStandings",
            "scheduledEvents.payload.scheduledEvents",
            "calendar.payload.worldTime",
            "history.payload.history"
          ]
        }
      ]
    },
    {
      "type": "snapshot",
      "name": "after_valid_increase"
    },
    {
      "type": "request",
      "name": "reject_unknown_skill",
      "method": "POST",
      "route": "/api/player/skills/QA%20Unknown%20Skill/increase",
      "body": {
        "amount": 1
      }
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 400
        },
        {
          "type": "responseOk",
          "equals": false
        },
        {
          "type": "equals",
          "source": "responses.reject_unknown_skill",
          "path": "payload.success",
          "equals": false
        },
        {
          "type": "equals",
          "source": "responses.reject_unknown_skill",
