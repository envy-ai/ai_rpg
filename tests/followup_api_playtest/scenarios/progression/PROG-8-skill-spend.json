          "equals": "Unknown skill: QA Unknown Skill"
        },
        {
          "type": "stateUnchanged",
          "beforeSource": "snapshots.after_valid_increase",
          "afterSource": "after",
          "paths": [
            "player.payload.player",
            "players.payload.players",
            "locations.payload.locations",
            "things.payload.things",
            "factions.payload.factions",
            "factions.payload.playerStandings",
            "scheduledEvents.payload.scheduledEvents",
            "calendar.payload.worldTime",
            "history.payload.history"
          ]
        }
      ]
    },
    {
      "type": "request",
      "name": "reject_overspend",
      "method": "POST",
      "route": "/api/player/skills/Alchemy/increase",
      "body": {
        "amount": 8
      }
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 400
        },
        {
          "type": "responseOk",
          "equals": false
        },
        {
          "type": "equals",
          "source": "responses.reject_overspend",
          "path": "payload.success",
          "equals": false
        },
        {
          "type": "equals",
          "source": "responses.reject_overspend",
          "path": "payload.error",
          "equals": "Not enough unspent skill points"
        },
        {
          "type": "stateUnchanged",
          "beforeSource": "snapshots.after_valid_increase",
          "afterSource": "after",
          "paths": [
            "player.payload.player",
            "players.payload.players",
            "locations.payload.locations",
            "things.payload.things",
            "factions.payload.factions",
            "factions.payload.playerStandings",
            "scheduledEvents.payload.scheduledEvents",
            "calendar.payload.worldTime",
            "history.payload.history"
