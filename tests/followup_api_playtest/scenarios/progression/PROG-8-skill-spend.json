          "equals": 8
        }
      ]
    },
    {
      "type": "request",
      "name": "increase_alchemy",
      "method": "POST",
      "route": "/api/player/skills/Alchemy/increase",
      "body": {
        "amount": 1
      }
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.increase_alchemy",
          "path": "payload.success",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.increase_alchemy",
          "path": "payload.skill.name",
          "equals": "Alchemy"
        },
        {
          "type": "equals",
          "source": "responses.increase_alchemy",
          "path": "payload.skill.rank",
          "equals": 6
        },
        {
          "type": "equals",
          "source": "responses.increase_alchemy",
          "path": "payload.amount",
          "equals": 1
        },
        {
          "type": "equals",
          "source": "responses.increase_alchemy",
          "path": "payload.player.skills.Alchemy",
          "equals": 6
        },
        {
          "type": "equals",
          "source": "responses.increase_alchemy",
          "path": "payload.player.unspentSkillPoints",
          "equals": 7
