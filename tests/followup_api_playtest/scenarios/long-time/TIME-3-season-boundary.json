{
  "version": 1,
  "scenario": "long-time",
  "case": "TIME-3-season-boundary",
  "description": "Cross the Winter-to-Spring boundary by five minutes and prove canonical client-facing calendar labels plus exactly one deterministic regional-weather recomputation.",
  "fixture": "long-time-season-boundary",
  "configProfile": "long-time-mechanics",
  "trackedPaths": [
    "player.payload.player.locationId",
    "player.payload.player.needBars",
    "player.payload.player.statusEffects",
    "regions.payload.regions",
    "scheduledEvents.payload.scheduledEvents",
    "calendar.payload.calendarDefinition",
    "calendar.payload.worldTime",
    "history.payload.history"
  ],
  "steps": [
    {
      "type": "loadFixture"
    },
    {
      "type": "request",
      "name": "player_before_boundary",
      "method": "GET",
      "route": "/api/npcs/$fixture.playerId"
    },
    {
      "type": "request",
      "name": "region_before_boundary",
      "method": "GET",
      "route": "/api/regions/$fixture.regionId"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.player_before_boundary",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.player_before_boundary",
          "path": "payload.npc.elapsedTime",
          "equals": 84958
        },
        {
          "type": "equals",
          "source": "responses.region_before_boundary",
          "path": "payload.region.weather.hasDynamicWeather",
          "equals": true
        },
        {
          "type": "count",
          "source": "responses.region_before_boundary",
          "path": "payload.region.weather.seasonWeather",
          "equals": 2
        },
        {
          "type": "equals",
          "source": "responses.region_before_boundary",
          "path": "payload.region.weather.seasonWeather.0.seasonName",
          "equals": "Winter"
        },
        {
          "type": "equals",
          "source": "responses.region_before_boundary",
          "path": "payload.region.weather.seasonWeather.1.seasonName",
          "equals": "Spring"
        },
        {
          "type": "equals",
          "source": "responses.region_before_boundary",
          "path": "payload.region.weatherState.seasonName",
          "equals": "Winter"
        },
        {
          "type": "equals",
          "source": "responses.region_before_boundary",
          "path": "payload.region.weatherState.name",
          "equals": "$fixture.winterWeatherName"
        },
        {
          "type": "equals",
          "source": "responses.region_before_boundary",
          "path": "payload.region.weatherState.description",
          "equals": "$fixture.winterWeatherDescription"
        },
        {
          "type": "equals",
          "source": "responses.region_before_boundary",
          "path": "payload.region.weatherState.durationMinutes",
          "equals": "$fixture.weatherDurationMinutes"
        },
        {
          "type": "equals",
          "source": "responses.region_before_boundary",
          "path": "payload.region.weatherState.nextChangeMinutes",
          "equals": "$fixture.winterWeatherNextChangeMinutes"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.dayIndex",
          "equals": "$fixture.boundaryDayIndex"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.timeMinutes",
          "equals": "$fixture.boundaryTimeMinutes"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.dateLabel",
          "equals": "$fixture.boundaryDateLabel"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.season",
          "equals": "Winter"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.weatherName",
          "equals": "$fixture.winterWeatherName"
        }
      ]
    },
    {
      "type": "snapshot",
      "name": "before_season_boundary"
    },
    {
      "type": "request",
      "name": "cross_season_boundary",
      "method": "POST",
      "route": "/api/slash-command",
      "body": {
        "command": "time",
        "argsText": "+5 minutes"
      }
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.dayIndex",
          "equals": 59
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.timeMinutes",
          "equals": 3
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.segment",
          "equals": "night"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.timeLabel",
          "equals": "12:03 AM"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.dateLabel",
          "equals": "Wednesday, March 1, Common Era 1"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.date.weekday",
          "equals": "Wednesday"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.date.monthName",
          "equals": "March"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.date.dayOfMonth",
          "equals": 1
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.date.year",
          "equals": 1
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.season",
          "equals": "Spring"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.seasonDescription",
          "equals": "Mild rain, fresh growth, and renewed travel as markets and communities become busier."
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.lighting",
          "equals": "Nighttime conditions with limited natural light."
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.holiday",
          "equals": null
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.holidayName",
          "equals": null
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.weatherName",
          "equals": "$fixture.springWeatherName"
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.weatherDescription",
          "equals": "$fixture.springWeatherDescription"
        },
        {
          "type": "stateUnchanged",
          "beforeSource": "snapshots.before_season_boundary",
          "afterSource": "after",
          "paths": [
            "player.payload.player.locationId",
            "player.payload.player.statusEffects",
            "scheduledEvents.payload.scheduledEvents",
            "calendar.payload.calendarDefinition",
            "history.payload.history"
          ]
        }
      ]
    },
    {
      "type": "request",
      "name": "player_after_boundary",
      "method": "GET",
      "route": "/api/npcs/$fixture.playerId"
    },
    {
      "type": "request",
      "name": "region_after_boundary",
      "method": "GET",
      "route": "/api/regions/$fixture.regionId"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.player_after_boundary",
          "path": "status",
          "equals": 200
        },
        {
          "type": "exactDelta",
          "beforeSource": "responses.player_before_boundary",
          "afterSource": "responses.player_after_boundary",
          "path": "payload.npc.elapsedTime",
          "delta": 5
        },
        {
          "type": "equals",
          "source": "responses.player_after_boundary",
          "path": "payload.npc.elapsedTime",
          "equals": 84963
        },
        {
          "type": "equals",
          "source": "responses.region_after_boundary",
          "path": "payload.region.weatherState.seasonName",
          "equals": "Spring"
        },
        {
          "type": "equals",
          "source": "responses.region_after_boundary",
          "path": "payload.region.weatherState.name",
          "equals": "$fixture.springWeatherName"
        },
        {
          "type": "equals",
          "source": "responses.region_after_boundary",
          "path": "payload.region.weatherState.description",
          "equals": "$fixture.springWeatherDescription"
        },
        {
          "type": "equals",
          "source": "responses.region_after_boundary",
          "path": "payload.region.weatherState.durationMinutes",
          "equals": "$fixture.weatherDurationMinutes"
        },
        {
          "type": "equals",
          "source": "responses.region_after_boundary",
          "path": "payload.region.weatherState.nextChangeMinutes",
          "equals": "$fixture.springWeatherNextChangeMinutes"
        }
      ]
    },
    {
      "type": "request",
      "name": "resolve_calendar_again",
      "method": "GET",
      "route": "/api/calendar"
    },
    {
      "type": "request",
      "name": "region_after_second_resolution",
      "method": "GET",
      "route": "/api/regions/$fixture.regionId"
    },
    {
      "type": "assert",
      "assertions": [
        {
          "type": "httpStatus",
          "equals": 200
        },
        {
          "type": "responseOk",
          "equals": true
        },
        {
          "type": "equals",
          "source": "responses.resolve_calendar_again",
          "path": "status",
          "equals": 200
        },
        {
          "type": "equals",
          "source": "responses.resolve_calendar_again",
          "path": "payload.worldTime.season",
          "equals": "Spring"
        },
        {
          "type": "equals",
          "source": "responses.resolve_calendar_again",
          "path": "payload.worldTime.weatherName",
          "equals": "$fixture.springWeatherName"
        },
        {
          "type": "equals",
          "source": "responses.region_after_second_resolution",
          "path": "payload.region.weatherState",
          "equalsFrom": {
            "source": "responses.region_after_boundary",
            "path": "payload.region.weatherState"
          }
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.dayIndex",
          "equals": 59
        },
        {
          "type": "equals",
          "source": "after",
          "path": "calendar.payload.worldTime.timeMinutes",
          "equals": 3
        },
        {
          "type": "equals",
          "source": "after",
          "path": "scheduledEvents.payload.count",
          "equals": 0
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs"
        }
      ]
    }
  ]
}
