          "type": "historyAddedTypeCount",
          "entryType": "while-you-were-away",
          "equals": 1,
          "beforeSource": "snapshots.before_blank_teleport",
          "afterSource": "after"
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "while-you-were-away-player",
          "equals": 1,
          "beforeSource": "snapshots.before_blank_teleport",
          "afterSource": "after"
        },
        {
          "type": "historyAddedTypeCount",
          "entryType": "player-action",
          "equals": 0,
          "beforeSource": "snapshots.before_blank_comment",
          "afterSource": "after"
        },
        {
          "type": "noRealtimeErrors"
        },
        {
          "type": "noUnexpectedErrorLogs"
        }
      ]
    }
  ],
  "humanReview": [
    "Confirm the event-driven TinyBrain movement contains coherent destination prose for QA Fast Travel Grove and does not add a second visible reunion narration.",
    "Confirm the blank map/Favorites branch adds one ordinary visible return scene and does not fabricate a second trip or conflicting destination."
  ]
}
