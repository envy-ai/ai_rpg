  "scenes": [
    {
      "startIndex": 1,
      "endIndex": 33,
      "startEntryId": "21df9750-3d71-4a6a-bfc1-d433ce4d15da",
      "endEntryId": "req-msgyvrm6-0b14vunx7ep",
      "summary": "Baato arrives in Ember Hollow on New Year’s Day and is immediately put to the test by the village elders. Mirei Hoshino demands he chop onions for her broth quota, while Tsubaki Morino quizzes him on herbal knowledge. Baato struggles initially with his knife work and guesses incorrectly on the herbs, but he listens to corrections, improves his chopping, and answers the second round of questions correctly. He also manages a promise to Hana Mizuki, moving her crates after finishing his onions. Through this series of tasks, Baato proves his reliability and earns the respect of Mirei and Tsubaki, establishing his reputation as a hardworking newcomer.\n\n- Mirei needs 50 bowls of broth by noon.\n- Tsubaki tests Baato on Nettle, Mugwort, and Yarrow.\n- Baato failed the first herb guess but passed the second.\n- Hana Mizuki is a slime who freezes in the cold.\n- Baato earned 5 paws from Mirei for the onion work.\n\n\nMirei Hoshino\n\nYou listened. That’s rare here.\n\n\n\nTsubaki Morino\n\nCorrect. All three. Follow me to the shop. We'll do the sorting drill now.",
      "details": [
        "Mirei needs 50 bowls of broth by noon.",
        "Tsubaki tests Baato on Nettle, Mugwort, and Yarrow.",
        "Baato failed the first herb guess but passed the second.",
        "Hana Mizuki is a slime who freezes in the cold.",
        "Baato earned 5 paws from Mirei for the onion work."
      ],
      "quotes": [
        {
          "character": "Mirei Hoshino",
          "text": "You listened. That’s rare here."
        },
        {
          "character": "Tsubaki Morino",
          "text": "Correct. All three. Follow me to the shop. We'll do the sorting drill now."
        }
      ]
    },
    {
      "startIndex": 34,
      "endIndex": 88,
      "startEntryId": "ef7aa776-654f-4018-b1ab-a667420e21e4",
      "endEntryId": "368ce028-f106-4b5d-a7c4-e3f7b39c06c2",
      "summary": "Baato follows Tsubaki to the Herbal Alchemy Shop, where he undergoes a practical sorting drill to confirm his herbal knowledge. He passes, earning the respect of Tsubaki and the attention of Mizuchi, a snake-like alchemist waiting for a moonbloom recipe. Baato is then tasked with sorting stock in the back room, where he is identified as Tsubaki’s new apprentice. He receives the key to the loft above the shop, confirming his accommodation and status. During this time, he also meets Yuzu, who shows him his new living quarters and identifies a harmless moonvine plant growing in the stairwell.\n\n- Baato is officially Tsubaki's apprentice.\n- He received the brass key to the Stock Room and the loft.\n- Mizuchi received her moonbloom recipe packet.\n- Yuzu identified the stairwell plant as harmless moonvine.\n- The loft is small, dry, and has an east-facing window.\n- Baato must sort the next shipment before opening tomorrow.\n\n\nTsubaki Morino\n\nYou passed the tests. You took the key. That’s how apprenticeships start here.\n\n\n\nBaato\n\nWhen did I end up as your apprentice, exactly?",
      "details": [
        "Baato is officially Tsubaki's apprentice.",
        "He received the brass key to the Stock Room and the loft.",
        "Mizuchi received her moonbloom recipe packet.",
        "Yuzu identified the stairwell plant as harmless moonvine.",
        "The loft is small, dry, and has an east-facing window.",
        "Baato must sort the next shipment before opening tomorrow."
      ],
      "quotes": [
        {
          "character": "Tsubaki Morino",
          "text": "You passed the tests. You took the key. That’s how apprenticeships start here."
        },
        {
          "character": "Baato",
          "text": "When did I end up as your apprentice, exactly?"
        }
      ]
    }
  ],
