            <name>{{ effect.name | default('unknown', true) }}</name>
            <description>{{ effect.description }}</description>
            <duration>{{ effect.duration | default('unknown') }}</duration>
          </effect>
          {% endfor %}
        </statusEffects>
        <value>{{ item.value | default(0) }}</value>
        <weight>{{ item.weight | default(0) }}</weight>
        <properties>{{ item.properties | default('', true) }}</properties>{% if item.modPromptXml %}
{{ item.modPromptXml | safe }}{% endif %}
      </item>
      {% endif %}
      {% endfor %}
    {% endif %}</inventory>
    {% endif %}
    <questCapacity>
      <activeQuestCount>{{ currentPlayer.currentQuests | length }}</activeQuestCount>
      <softQuestLimit>{{ config.soft_quest_limit }}</softQuestLimit>
    </questCapacity>
    <needs>
{% for sentence in currentPlayer.needs %}      - {{ sentence }}
{% endfor %}    </needs>
    {{ renderRelationshipPromptSections(currentPlayer) }}
    {% if currentPlayer.modStatusSections and currentPlayer.modStatusSections.length %}
    <modStatus>
      {% for section in currentPlayer.modStatusSections %}
      <section key="{{ section.key }}" label="{{ section.label }}">
        {% for entry in section.entries %}
        <entry>
          {% if entry.slot %}<slot>{{ entry.slot }}</slot>{% endif %}
          {% if entry.itemName %}<itemName>{{ entry.itemName }}</itemName>{% endif %}
          {% if entry.name %}<name>{{ entry.name }}</name>{% endif %}
          {% if entry.level %}<level>{{ entry.level }}</level>{% endif %}
          {% if entry.manaUsage %}<manaUsage>{{ entry.manaUsage }}</manaUsage>{% endif %}
          {% if entry.cost %}<cost>{{ entry.cost }}</cost>{% endif %}
          {% if entry.description %}<description>{{ entry.description }}</description>{% endif %}
          {% if entry.effectSummary %}<effectSummary>{{ entry.effectSummary }}</effectSummary>{% endif %}
        </entry>
        {% endfor %}
      </section>
      {% endfor %}
    </modStatus>
    {% endif %}
    {% if not effectiveSuppressQuestList %}
    <quests>
      {% for quest in currentPlayer.currentQuests %}
      <quest>
        <name>{{ quest.name }}</name>
        <description>{{ quest.description }}</description>
        {% if quest.secretNotes %}<secretNotes>{{ quest.secretNotes }}</secretNotes>{% endif -%}
        <objectives>
          {%- for objective in quest.objectives %}
          <objective completed="{{ objective.completed }}" optional="{{ objective.optional }}" index="{{ loop.index }}">{{ objective.description }}</objective>
          {% endfor -%}
        </objectives>
        {% if quest.rewardBenefits and quest.rewardBenefits.length %}
        <rewardBenefits>
          {% for benefit in quest.rewardBenefits %}
          <benefit id="{{ benefit.id }}" type="{{ benefit.type }}">
            <label>{{ benefit.label }}</label>
            <targetId>{{ benefit.targetId }}</targetId>
            {% if benefit.description %}<description>{{ benefit.description }}</description>{% endif %}
            {% if benefit.role %}<role>{{ benefit.role }}</role>{% endif %}
          </benefit>
          {% endfor %}
        </rewardBenefits>
        {% endif %}
        {% if quest.rewardNotes and quest.rewardNotes.length %}
        <rewardNotes>
          {% for note in quest.rewardNotes %}<note>{{ note }}</note>{% endfor %}
        </rewardNotes>
        {% endif %}
        <giver>{{ quest.giver }}</giver>
      </quest>
      {% endfor %}
    </quests>
    {% endif %}
  </player>
{% if ignorePromptLevelOmissions %}[[[AI_RPG_INTERNAL_MESSAGE_BOUNDARY_BASE_CONTEXT_SECTION_V1]]]{% endif %}
  <playerParty>
    {% for member in party %}
    <member>
      <id>{{ member.id | default('unknown', true) }}</id>
      <name>{{ member.name }}</name>
      <isDead>{{ member.isDead | default(false) }}</isDead>
      {% if member.hiddenFromPlayer %}<hidden>true</hidden>{% endif %}
      <description>{{ member.description }}</description>
      <class>{{ member.class | default('Unknown') }}</class>
      <race>{{ member.race | default('Unknown') }}</race>
      <personality>
        <type>{{ member.personality.type | default('Unknown', true) }}</type>
        <traits>{{ member.personality.traits | default('None', true) }}</traits>
        <goals>
          {% for goal in member.personality.goals %}<goal>{{ goal }}</goal>
          {% endfor %}
        </goals>
        <notes>{{ member.personality.notes | default('', true) }}</notes>
        <aiNotes>{{ member.aiNotes | default(member.personality.aiNotes, true) | default('', true) }}</aiNotes>
      </personality>
      {{ renderPlayerEntityFields(member) }}
{#      <health>{{ member.health | default('unknown') }}</health>
      <maxHealth>{{ member.maxHealth | default('unknown') }}</maxHealth> #}
      <dispositionsTowardsPlayer>
        {% for disposition in member.dispositionsTowardsPlayer %}
        <dispositionTowardsPlayer>
          <type>{{ disposition.type }}</type>
          <intensity>{{ disposition.intensityName }}</intensity>
        </dispositionTowardsPlayer>
        {% endfor %}
      </dispositionsTowardsPlayer>
      {{ renderRelationshipPromptSections(member) }}
      <importantMemories>
        {% for entry in member.selectedImportantMemories %}
        <memory>{{ entry.memory }}</memory>
        {% endfor %}
      </importantMemories>
      {% if not effectiveOmitInventoryItems %}
      <inventory>{% if useShortDescriptions -%}
{%- for item in member.inventory -%}
{%- set installedModuleBaseId = item.moduleInstalledOnItemId | default('', true) | lower -%}
{%- if installedModuleBaseId in ['', 'n/a', 'none', 'null'] -%}
{{ item.name }}: {{ itemQuantityField(item) }}{{ item.rarity | default('common', true) }} level {{ item.level | default(1, true) }} {{ itemValueSummary(item) }} - {{ item.shortDescription | default(item.description, true) }}{% if item.equippedSlot %} (Equipped to {{ item.equippedSlot }}){% endif %}{% if not loop.last %}{{ "\n" }}{% endif %}
{%- endif -%}
{%- endfor -%}
{%- else %}
        {% for item in member.inventory %}
          {% set installedModuleBaseId = item.moduleInstalledOnItemId | default('', true) | lower %}
          {% if installedModuleBaseId in ['', 'n/a', 'none', 'null'] %}
        <item>
          <name>{{ item.name }}</name>
          <equippedSlot>{{ item.equippedSlot | default('none') }}</equippedSlot>
        </item>
          {% endif %}
      {% endfor %}{% endif %}</inventory>
      {% endif %}
      <skills>
        {% for skill in member.skills %}{% if skill.value > 1 %}{{ skill.name }}, {% endif %}{% endfor %}
      </skills>
      {% if not effectiveOmitAbilities %}
      <abilities>{% if useShortDescriptions -%}
{%- for ability in member.abilities -%}
{{ ability.name }}: level {{ ability.level | default(1, true) }} - {{ ability.shortDescription | default(ability.description, true) }}{% if not loop.last %}{{ "\n" }}{% endif %}
{%- endfor -%}
{%- else %}
        {% for ability in member.abilities %}
        <ability>
          <name>{{ ability.name }}</name>
          <description>{{ ability.description }}</description>
          <type>{{ ability.type }}</type>
          <level>{{ ability.level }}</level>
        </ability>
        {% endfor %}
      {% endif %}</abilities>
      {% endif %}
      <statusEffects>
        {% for effect in member.statusEffects %}
        <effect>
          <name>{{ effect.name | default('unknown', true) }}</name>
          <description>{{ effect.description }}</description>
          <duration>{{ effect.duration | default('unknown') }}</duration>
        </effect>
        {% endfor %}
      </statusEffects>
      <needs>
{% for sentence in member.needs %}        - {{ sentence }}
{% endfor %}      </needs>
      {% if member.modStatusSections and member.modStatusSections.length %}
      <modStatus>
        {% for section in member.modStatusSections %}
        <section key="{{ section.key }}" label="{{ section.label }}">
          {% for entry in section.entries %}
          <entry>
            {% if entry.slot %}<slot>{{ entry.slot }}</slot>{% endif %}
            {% if entry.itemName %}<itemName>{{ entry.itemName }}</itemName>{% endif %}
            {% if entry.name %}<name>{{ entry.name }}</name>{% endif %}
            {% if entry.level %}<level>{{ entry.level }}</level>{% endif %}
            {% if entry.manaUsage %}<manaUsage>{{ entry.manaUsage }}</manaUsage>{% endif %}
            {% if entry.cost %}<cost>{{ entry.cost }}</cost>{% endif %}
            {% if entry.description %}<description>{{ entry.description }}</description>{% endif %}
            {% if entry.effectSummary %}<effectSummary>{{ entry.effectSummary }}</effectSummary>{% endif %}
          </entry>
          {% endfor %}
        </section>
        {% endfor %}
      </modStatus>
      {% endif %}
    </member>
    {% endfor %}
  </playerParty>
{% if ignorePromptLevelOmissions %}[[[AI_RPG_INTERNAL_MESSAGE_BOUNDARY_BASE_CONTEXT_SECTION_V1]]]{% endif %}
  <additionalLore>
    {{ additionalLore }}
  </additionalLore>
  <itemContext>
    {% if itemContext %}{{ itemContext }}{% endif %}
  </itemContext>
  <abilityContext>
    {% if abilityContext %}{{ abilityContext }}{% endif %}
  </abilityContext>
  {% if plotSummary and plotSummary | trim %}
  <plotSummary>{{ plotSummary }}</plotSummary>
  {% endif %}
  {% if plotExpander and plotExpander | trim %}
  <plotExpander>{{ plotExpander }}</plotExpander>
  {% endif %}
  {% if ignorePromptLevelOmissions and ((activeMysteryThreads and activeMysteryThreads.length) or (trackers and trackers.length)) %}
[[[AI_RPG_INTERNAL_MESSAGE_BOUNDARY_BASE_CONTEXT_SECTION_V1]]]
  {% endif %}
  {% if activeMysteryThreads and activeMysteryThreads.length %}
  <activeMysteryThreads max="{{ mysteryThreadMaxActive | default(activeMysteryThreads.length, true) }}">
    <instructions>GM-private continuity. Preserve these mystery facts and constraints when generating new material, but do not directly reveal hidden truth unless the player discovers it through play.</instructions>
    {% for thread in activeMysteryThreads %}
    <mysteryThread id="{{ thread.id }}">
      <name>{{ thread.name }}</name>
      <status>{{ thread.status }}</status>
      {% if thread.keys and thread.keys.length %}
      <keys>{% for key in thread.keys %}<key>{{ key }}</key>{% endfor %}</keys>
      {% endif %}
      {% if thread.summary %}
      <summary>{{ thread.summary }}</summary>
      {% endif %}
      {% if thread.constraints and thread.constraints.length %}
      <constraints>{% for constraint in thread.constraints %}<constraint>{{ constraint }}</constraint>{% endfor %}</constraints>
      {% endif %}
      {% if thread.mysteryBoxes and thread.mysteryBoxes.length %}
      <mysteryBoxes>
        {% for box in thread.mysteryBoxes %}
        {% if not box.resolved %}
        <mysteryBox id="{{ box.id }}">
          <name>{{ box.name }}</name>
          {% if box.keys and box.keys.length %}
          <keys>{% for key in box.keys %}<key>{{ key }}</key>{% endfor %}</keys>
          {% endif %}
          <text>{{ box.text }}</text>
        </mysteryBox>
        {% endif %}
        {% endfor %}
      </mysteryBoxes>
      {% endif %}
    </mysteryThread>
    {% endfor %}
  </activeMysteryThreads>
  {% endif %}
  {% if trackers and trackers.length %}
  <trackers>
    {% for tracker in trackers %}
    {{ tracker.id }} | {{ tracker.name }} | type={{ tracker.type }} | value={{ tracker.value }} | hidden={{ tracker.hidden }} | lastUpdated={{ tracker.lastUpdated }} | guidance={{ tracker.guidance }} | note={{ tracker.note | default("") }}
    {% endfor %}
  </trackers>
  {% endif %}
{% if ignorePromptLevelOmissions %}[[[AI_RPG_INTERNAL_MESSAGE_BOUNDARY_RECENT_STORY_HISTORY_V1]]]{% endif %}  <recentStoryHistory>{{ recentGameHistory }}</recentStoryHistory>
</gameState>
