    <isArriving>{{ currentVehicle.isArriving | default(false, true) }}</isArriving>
    {% if currentVehicle.location and (currentVehicle.location | trim) %}
    <location>{{ currentVehicle.location | default('', true) }}</location>
    {% endif %}
    {% if currentVehicle.destination and (currentVehicle.destination | trim) %}
    <destination>{{ currentVehicle.destination | default('', true) }}</destination>
    <destinationResolved>{{ currentVehicle.destinationResolved | default(false, true) }}</destinationResolved>
    {% if currentVehicle.pendingDestination %}
    <pendingDestination>
      {% if currentVehicle.pendingDestination.locationName and (currentVehicle.pendingDestination.locationName | trim) %}
      <location>{{ currentVehicle.pendingDestination.locationName }}</location>
      {% endif %}
      {% if currentVehicle.pendingDestination.regionName and (currentVehicle.pendingDestination.regionName | trim) %}
      <region>{{ currentVehicle.pendingDestination.regionName }}</region>
      {% endif %}
      {% if currentVehicle.pendingDestination.rawText and (currentVehicle.pendingDestination.rawText | trim) %}
      <rawText>{{ currentVehicle.pendingDestination.rawText }}</rawText>
      {% endif %}
    </pendingDestination>
    {% endif %}
    {% if currentVehicle.minutesToDestination != null %}
    <minutesToDestination>{{ currentVehicle.minutesToDestination }}</minutesToDestination>
    {% endif %}
    <timeToDestination>{{ currentVehicle.timeToDestination | default('', true) }}</timeToDestination>
    {% endif %}
  </vehicle>
  {% endif %}
  <currentCharacterNeeds>
    {% set listedPartyMemberIds = partyMemberIds | default([], true) %}
    {% for npc in npcs %}
    {% if not (npc.isDead | default(false)) and (not npc.id or not (npc.id in listedPartyMemberIds)) and npc.needs and npc.needs | length %}
    <character>
      <name>{{ npc.name }}</name>
      <needs>
{% for sentence in npc.needs %}        - {{ sentence }}
{% endfor %}      </needs>
    </character>
    {% endif %}
    {% endfor %}
    {% for member in party %}
    {% if not (member.isDead | default(false)) and member.needs and member.needs | length %}
    <character>
      <name>{{ member.name }}</name>
      <needs>
{% for sentence in member.needs %}        - {{ sentence }}
{% endfor %}      </needs>
    </character>
    {% endif %}
    {% endfor %}
  </currentCharacterNeeds>
</currentConditions>

{% include "_includes/randomwords.njk" %}

[[[AI_RPG_INTERNAL_BASE_CONTEXT_END_V1]]]
