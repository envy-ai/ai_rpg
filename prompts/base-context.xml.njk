    <currentTime>{{ worldTime.timeLabel }}</currentTime>
    <timeSegment>{{ worldTime.segment }}</timeSegment>
    <season>{{ worldTime.season }}</season>
    <seasonDescription>{{ worldTime.seasonDescription | default('', true) }}</seasonDescription>
