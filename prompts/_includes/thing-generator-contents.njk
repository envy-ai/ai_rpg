<attributeDefinitions>
{% if attributeDefinitions %}
    {% for attrName, attrDef in attributeDefinitions | dictsort %}
    <attribute>
    <name>{{ attrName }}</name>
    <description>{{ attrDef.description }}</description>
    </attribute>
    {% endfor %}
{% endif %}
</attributeDefinitions>
<equipmentSlots>
{% for slot in equipmentSlots %}  <slot>{{ slot }}</slot>
{% endfor %}
</equipmentSlots>

<task>Generate {% if itemBatchPlanningOnly %}a compact roster for{% endif %} the contents of the container "{{ container.name }}". Do not generate the container itself. Preserve every listed name exactly and generate at least its listed total count. You may combine or split stacks with the same name, increase their quantities, and add other suitable items inside this container. Every returned entry must be an item, including any additional entries. All returned entries will go inside this container. Fill in the fields to fit the setting, current location, and current region. Choose sensible numeric values yourself; do not use randomness. Do not make tool calls.</task>

{% include "_includes/generation-prompt-instructions.njk" %}

{% if itemBatchPlanningOnly %}
<requestedContents>{% for content in container.containerContents %}<item><name>{{ content.name | escape }}</name><count>{{ content.count }}</count></item>{% endfor %}</requestedContents>
{% include "_includes/item-batch-plan.njk" %}
{% else %}
<items>
{% for content in container.containerContents %}
{% set thingSeed = content %}
{% include "_includes/item.njk" %}
{% endfor %}
</items>
{% endif %}
