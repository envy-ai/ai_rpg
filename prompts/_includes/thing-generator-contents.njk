<attributeDefinitions>
{% if attributeDefinitions %}
    {% for attrName, attrDef in attributeDefinitions | dictsort %}
    <attribute>
    <name>{{ attrName }}</name>
    <description>{{ attrDef.description }}</description>
    </attribute>
    {% endfor %}
{% endif %}
</attributeDefinitions>
<equipmentSlots>
{% for slot in equipmentSlots %}  <slot>{{ slot }}</slot>
{% endfor %}
</equipmentSlots>

<task>Generate only the items listed inside the container "{{ container.name }}". Do not generate the container itself. The template below contains exactly the required top-level item entries. Do not add, remove, combine, split, rename, or recount them. Keep every name and count exactly as shown, and fill in only the remaining fields in a way that fits the setting, current location, and current region. Return the completed template in this format:</task>

{% include "_includes/generation-prompt-instructions.njk" %}

<items>
{% for content in container.containerContents %}
{% set thingSeed = content %}
{% include "_includes/item.njk" %}
{% endfor %}
</items>
