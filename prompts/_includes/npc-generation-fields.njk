{# Shared NPC child fields. Callers set npcGenerationVariant to region, location, or single.
   Keep wrappers, character guidance, memories, and generation-only references in callers.
   Only single consumes core/extension seeds, except startingHealthPercentage, which
   historically honors an explicit npc value in every variant. #}
{% if not locationNpcCheckpoint %}<quantity><!-- Positive integer number of NPCs that share this same profile. Usually 1, but can be more for groups of identical or near-identical NPCs, like a group of soldiers in the same faction wearing the same uniform and armor and sharing the same stats and role in the location. The name and description of NPCs of any quantity should always be singular; a plural entry will be expanded to individuals. --></quantity>{% endif %}
{% if npcGenerationVariant == 'single' and npc.name %}<!--Name is fixed; do not change it except to make it singular if it is plural.-->{% endif %}
{% if not locationNpcCheckpoint %}
<name>{% if npcGenerationVariant == 'single' and npc.name %}{{ npc.name }}{% else %}<!--Full name of the NPC. Do not use the name of an existing or deceased NPC. If this is part of a group of generic enemies, make the name singular.{% if setting.npcNamingGuidance | default('', true) | trim %} NPC Naming Guidance: {{ setting.npcNamingGuidance | xmlComment }}{% endif %}-->{% endif %}</name>
{% endif %}
{% if not locationNpcCheckpoint %}<description>{% if npcGenerationVariant == 'single' and npc.description %}{{ npc.description | replace('\n', ' ') }}{% else %}<!--Three sentences describing their appearance, personality, role, typical behavior, and distinguishing details. Do not describe where they are or what they are currently doing. Replace their name with %NAME%.-->{% endif %}</description>{% endif %}
<shortDescription>{% if npcGenerationVariant == 'single' and npc.shortDescription %}{{ npc.shortDescription }}{% else %}<!--Ten words or fewer summarizing the NPC. Replace their name with %NAME%.--> {% endif %}</shortDescription>
<role>{% if npcGenerationVariant == 'single' and npc.role %}{{ npc.role }}{% else %}<!--Clear role, job, or niche within the location.-->{% endif %}</role>
<class>{% if npcGenerationVariant == 'single' and npc.class %}{{ npc.class }}{% else %}<!--RPG class like warrior or cyberninja, job like blacksmith or cashier, or something generic like townsperson, peasant or citizen.-->{% endif %}</class>

<faction><!-- Full faction name from the list or "None" --></faction>
<race>{% if npcGenerationVariant == 'single' and npc.race %}{{ npc.race }}{% else %}<!--Species or origin (human, elf, android, etc).-->{% endif %}</race>

<!-- Only list things for resistances and vulnerabilities if they would differ significantly from a typical human. For example, if the NPC is a fire elemental, you might list "fire" under resistances and "cold" under vulnerabilities. If the NPC is a normal human with no particular resistances or vulnerabilities, leave these blank. For instance, humans aren't considered vulnerable to fire, as they take standard damage from it.-->
<resistances>{% if npcGenerationVariant == 'single' and npc.resistances %}{{ npc.resistances }}{% else %}<!--Any specific resistances, immunities, or things that are ineffective against them, and how resistant they are in parentheses ("resistant" or "immune"). "None" if none. Example: "slashing (resistant), cold (immune), charm effects (resistant)" -->{% endif %}</resistances>
<vulnerabilities>{% if npcGenerationVariant == 'single' and npc.vulnerabilities %}{{ npc.vulnerabilities }}{% else %}<!--Any specific vulnerabilities, weaknesses, or things that can be used against them, and how vulnerable they are in parentheses ("vulnerable" or "extremely vulnerable"). "None" if none. Example: "fire (extremely vulnerable), light (vulnerable), any magic (vulnerable)" -->{% endif %}</vulnerabilities>

<gender>{% if npcGenerationVariant == 'single' and npc.gender %}{{ npc.gender }}{% else %}<!--male, female, none, or other-->{% endif %}</gender>
{% if not locationNpcCheckpoint %}<isHostile>{% if npcGenerationVariant == 'single' and npc.isHostile is defined -%}{% if npc.isHostile in [true, 'true', 'True', 1, '1', 'yes', 'Yes', 'hostile', 'Hostile'] %}true{% else %}false{% endif %}{%- else -%}<!--true or false-->{%- endif %}</isHostile>{% endif %}
<disposition>{% if npcGenerationVariant == 'single' and npc.disposition %}{{ npc.disposition }}{% else %}<!-- Optional if no behavioral disposition applies: omit, leave empty, or use N/A if sentient. If non-sentient (animal-level intelligence or below), a brief blurb describing how this entity normally behaves toward the player and other NPCs. Examples: "extremely aggressive; attacks anything other than its own kind on sight, including other animals or NPCs"; "extremely territorial; assumes a warning posture for a turn or two, then attacks"; "ornery; becomes aggressive without warning if bothered or approached too closely"; "flees if approached, attacks only if cornered"; "flees immediately if it perceives the party in the same location"; "neutral; walks away if bothered, attacks only if attacked or intentionally provoked". -->{% endif %}</disposition>
<relativeLevel>{% if npcGenerationVariant == 'single' and npc.relativeLevel %}{{ npc.relativeLevel }}{% else %}<!--{% if npcGenerationVariant == 'region' %}Integer from +2 to +5 (relative to the average level in the region){% else %}Integer from -3 to +3. Larger quantities of NPCs should typically have a lower relativeLevel to compensate for their numbers.{% endif %}-->{% endif %}</relativeLevel>
{% if npcGenerationVariant == 'region' %}
<location><!--The location in the region where this NPC is located--></location>
{% endif %}
<currency>{% if npcGenerationVariant == 'single' and npc.currency %}{{ npc.currency }}{% else %}<!--Integer amount of currency the NPC has on hand, based on setting norms.-->{% endif %}</currency>
<attributes>
{% for attrName, attrDef in attributeDefinitions %}    <attribute name="{{ attrName }}"><!--Rating using: poor, below average, average, above average, excellent, or legendary.--></attribute>
{% endfor %}
</attributes>
<hiddenFromPlayer>{% if npcGenerationVariant == 'single' and npc.hiddenFromPlayer is defined -%}{% if npc.hiddenFromPlayer in [true, 'true', 'True', 1, '1', 'yes', 'Yes', 'hidden', 'Hidden'] %}true{% else %}false{% endif %}{%- else -%}<!--true for an entity that's not immediately obvious to the player; false otherwise-->{%- endif %}</hiddenFromPlayer>
<startingHealthPercentage>{% if npc.startingHealthPercentage is defined %}{{ npc.startingHealthPercentage }}{% else %}<!--Integer from 0 to 100 representing the NPC's starting health as a percentage of their maximum health. Usually 100, but may be lower if the NPC is injured or otherwise not at full health. 0 if for some reason the NPC is incapacitated. 'deceased' if the NPC is dead.-->{% endif %}</startingHealthPercentage>
<startingNeeds>
    {% for need in needBarDefinitions -%}
    <needBar>
        <id>{{ need.id }}</id>
        <isApplicable><!-- True if this need makes sense for this character, even if not quite literally (e.g., a non-human NPC might have a "hunger" need that represents a different kind of sustenance, like blood for a vampire). False otherwise, or if it's inappropriate (Sexual needs for a child NPC or non-sentient entity, for example) --></isApplicable>
        <startingLevel><!-- Initial level of the need bar, from 0% (empty) to 100% (fully satisfied). Should usually be 100% unless there's a reason for it not to be. Omit this entirely if not applicable. --></startingLevel>
    </needBar>
    {% endfor -%}
</startingNeeds>
<personality>
    <type><!-- -dere archetype, Enneagram type, Expanded 5x5 alignment (Lawful-Social-Neutral-Rebel-Chaotic and Good-Moral-Neutral-Impure-Evil), or similar short description. Optionally, 2 types separated by commas, so long as they make sense together. Then a short 2 sentence description of how they aren't just the stereotype of that personality. --></type>
    <traits><!-- optionally, any neurodivergences or mental health conditions (e.g. ADHD, autism, anxiety, depression, bipolar, PTSD, sociopathy, psychopathy, mania, any phobias, etc). Comma separated, usually none, no more than 3 --></traits>
    <characterArc>
        <shortTerm><!-- A brief description of the NPC's short-term active personal growth arc --></shortTerm>
        <longTerm><!-- A brief description of the NPC's long-term personal growth arc or development over the course of the campaign or story --></longTerm>
    </characterArc>
    <goals>
        <goal><!-- A specific, long-term goal the character is working towards --></goal>
        <goal><!-- Another specific, long-term goal the character is working towards --></goal>
        <goal><!-- A specific, short-term goal the character is actively pursuing --></goal>
        <goal><!-- Another specific, short-term goal the character is actively pursuing --></goal>
    </goals>
    <notes><!-- up to 2 paragraphs of additional information that's unique to the character. If the character has any secrets (known to the character themselves or not), put them here. --></notes>
</personality>
{% if npcGenerationVariant == 'single' %}
{% set playerFieldSeed = npc %}
{% else %}
{% set playerFieldSeed = {} %}
{% endif %}
{% include "_includes/player-generator-fields.njk" %}
<healthAttribute><!-- Name of the attribute (from the list) that determines health gained at level up. Usually something related to toughness or stamina, but may differ for particularly strange npcs or creatures --></healthAttribute>
<aiNotes>{% if npcGenerationVariant == 'single' and npc.aiNotes %}{{ npc.aiNotes }}{% else %}<!-- One or two brief sentences about things that might trigger the character to take action, like healing an injured ally, fleeing at low health, protecting a specific person, or pursuing a specific goal. -->{% endif %}</aiNotes>
{% include "_includes/npc-starting-techniques.njk" %}
