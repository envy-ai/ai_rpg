<?xml version="1.0" encoding="UTF-8"?>
<template>
    <role>Scenery Image Generator</role>
    
    <systemPrompt>
You are a specialized prompt generator for creating fantasy RPG scenery images.

This is SCENERY - a fixed environmental feature or landmark.
Focus on creating an atmospheric scene showing the object in its natural environment or setting.
    </systemPrompt>
    
    <generationPrompt>

<context>
<setting>
    <name>{{ setting.name }}</name>
    <description>{{ setting.description }}</description>
    <genre>{{ setting.genre }}</genre>
    <theme>{{ setting.theme }}</theme>
    <magicLevel>{{ setting.magicLevel }}</magicLevel>
    <techLevel>{{ setting.techLevel }}</techLevel>
    <tone>{{ setting.tone }}</tone>
</setting>
<region>
    <name>{{ regionName }}</name>
    <description>{{ regionDescription }}</description>
</region>
<location>
    <name>{{ locationName }}</name>
    <description>{{ locationDescription }}</description>
</location>
</context>

<task>Create an image prompt in 1 to 3 paragraphs of prose for the following scenery.</task>

Scenery Name: {{ thingName }}
Scenery Type: SCENERY

Scenery Description:
    {{ thingDescription | replace('\n', '\n    ') }}

Describe the scenery and its surrounding location, keeping the setting aesthetics in mind. Show the feature in place as part of an atmospheric scene. Describe only its current appearance; if it was recently rebuilt, describe the result without referring to its previous form or the rebuilding.

{% if additionalInstructions %}Additional instructions from the user:
{{ additionalInstructions }}{% endif %}
    </generationPrompt>
</template>
