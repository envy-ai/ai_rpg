+def terminal_logprobs(tokenizer, sample: dict, stop_ids) -> dict:
+    """Actual terminal sample, separate from visible content; retain every raw alternative."""
+    aligner = VisibleLogprobAligner(tokenizer)
+
+    def record(token_id, score):
+        data = aligner._bytes(token_id)
+        try:
+            text = data.decode("utf-8")
+        except UnicodeError:
+            text = None  # Un-decodable alternatives are metadata, never replacement text.
+        return {"id": token_id, "token": text, "bytes": list(data), "logprob": score}
+
+    chosen = record(sample["id"], sample["logprob"])
+    chosen["top_logprobs"] = [record(token_id, score) for token_id, score in sample["top"]]
+    return {"reason": "eos_token", "sample": chosen, "stop_token_ids": sorted(stop_ids)}
 
 
