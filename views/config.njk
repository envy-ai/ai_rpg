<!DOCTYPE html>
<html lang="en">
{% set pageTitleValue = title | default("System Configuration") %}
{% from "_includes/image-workflow-editor.njk" import workflowTab %}
<head>
    {% include "_includes/head-common.njk" %}
    <link rel="stylesheet" href="/css/config.css">
    <script defer src="/js/widgets/searchable-select.js"></script>
    <script defer src="/js/image-workflow-editor.js"></script>
</head>
<body>
    <div class="container">
        {% set appHeaderTitle = 'System Configuration' %}
        {% set appHeaderSubtitle = 'Configure server settings and AI parameters' %}
        {% include "_includes/app-header.njk" %}
        
        <div class="config-content">
            {% if savedMessage %}
                {% set statusClass = 'status-message success' %}
            {% elif errorMessage %}
                {% set statusClass = 'status-message error' %}
            {% else %}
                {% set statusClass = 'status-message' %}
            {% endif %}
            {% if savedMessage or errorMessage %}
                {% set statusDisplay = 'block' %}
            {% else %}
                {% set statusDisplay = 'none' %}
            {% endif %}
            <div id="status-message"
                 class="{{ statusClass }}"
                 style="display: {{ statusDisplay }};">
                {% if savedMessage %}
                    {{ savedMessage }}
                {% elif errorMessage %}
                    {{ errorMessage }}
                {% endif %}
            </div>

            <div class="config-page-tabs" role="tablist" aria-label="Configuration sections">
                <button type="button"
                        id="config-tab-button-server"
                        class="config-page-tab active"
                        data-config-tab-target="server"
                        role="tab"
                        aria-selected="true"
                        aria-controls="config-tab-server">
                    <span class="config-page-tab__icon" aria-hidden="true">🖥️</span>
                    <span><strong>Server</strong><small>Host and network</small></span>
                </button>
                <button type="button"
                        id="config-tab-button-ai"
                        class="config-page-tab"
                        data-config-tab-target="ai"
                        role="tab"
                        aria-selected="false"
                        aria-controls="config-tab-ai">
                    <span class="config-page-tab__icon" aria-hidden="true">🤖</span>
                    <span><strong>AI</strong><small>Models and providers</small></span>
                </button>
                <button type="button"
                        id="config-tab-button-story"
                        class="config-page-tab"
                        data-config-tab-target="story"
                        role="tab"
                        aria-selected="false"
                        aria-controls="config-tab-story">
                    <span class="config-page-tab__icon" aria-hidden="true">📚</span>
                    <span><strong>Story Engine</strong><small>Memory, events, and tone</small></span>
                </button>
                <button type="button"
                        id="config-tab-button-gameplay"
                        class="config-page-tab"
                        data-config-tab-target="gameplay"
                        role="tab"
                        aria-selected="false"
                        aria-controls="config-tab-gameplay">
                    <span class="config-page-tab__icon" aria-hidden="true">⚙️</span>
                    <span><strong>Gameplay</strong><small>World rules and generation</small></span>
                </button>
                <button type="button"
                        id="config-tab-button-images"
                        class="config-page-tab"
                        data-config-tab-target="images"
                        role="tab"
                        aria-selected="false"
                        aria-controls="config-tab-images">
                    <span class="config-page-tab__icon" aria-hidden="true">🎨</span>
                    <span><strong>Image Generation</strong><small>Models, workflows, and rendering</small></span>
                </button>
                <button type="button"
                        id="config-tab-button-image-prompts"
                        class="config-page-tab"
                        data-config-tab-target="image-prompts"
                        role="tab"
                        aria-selected="false"
                        aria-controls="config-tab-image-prompts">
                    <span class="config-page-tab__icon" aria-hidden="true">🖌️</span>
                    <span><strong>Image Prompts</strong><small>Global prompt-writing guidance</small></span>
                </button>
                <button type="button"
                        id="config-tab-button-game"
                        class="config-page-tab"
                        data-config-tab-target="game"
                        role="tab"
                        aria-selected="false"
                        aria-controls="config-tab-game">
                    <span class="config-page-tab__icon" aria-hidden="true">🎮</span>
                    <span><strong>Current Game</strong><small>Save-specific overrides</small></span>
                </button>
            </div>

            <div id="config-save-target" class="status-message info" role="note">
                Saving this page modifies <code>{{ configSaveTarget }}</code>.
            </div>

            <div class="config-tab-panels">
            <form id="configForm" method="POST">
            <section id="config-tab-server"
                     class="config-tab-panel"
                     data-config-tab-panel="server"
                     aria-labelledby="config-tab-button-server"
                     role="tabpanel">
                <div class="config-sections">
                <!-- Server Configuration -->
                <div class="config-section">
                    <h2>🖥️ Server Configuration</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="server-host">Host:</label>
                            <input type="text" id="server-host" name="server.host::string" value="{{ config.server.host }}" required>
                            <span class="help-text">Use 'localhost' for local only, '0.0.0.0' for external access</span>
                        </div>
                        
                        <div class="form-group">
                            <label for="server-port">Port:</label>
                            <input type="number" id="server-port" name="server.port::int" value="{{ config.server.port }}" min="1" max="65535" required>
                            <span class="help-text">Port number (1-65535)</span>
                        </div>
                    </div>
                </div>
                <div class="form-actions form-actions--panel">
                    <button type="submit" class="btn btn-primary">💾 Save Server Settings</button>
                </div>
            </section>

            <section id="config-tab-ai"
                     class="config-tab-panel"
                     data-config-tab-panel="ai"
                     aria-labelledby="config-tab-button-ai"
                     role="tabpanel"
                     hidden>
                <div class="config-sections" data-ai-configuration>
                
                <!-- AI Configuration -->
                    {% set aiBackend = config.ai.backend or 'openai_compatible' %}
                    {% set codexBridgeConfig = config.ai.codex_bridge or {} %}
                    {% set clineBridgeConfig = config.ai.cline_bridge or {} %}
                    {% set kimiBridgeConfig = config.ai.kimi_bridge or {} %}
                    {% set codexCommandValue = codexBridgeConfig.command or 'codex' %}
                    {% set codexHomeValue = codexBridgeConfig.home or './tmp/codex-bridge-home' %}
                    {% set codexSessionModeValue = codexBridgeConfig.session_mode or 'fresh' %}
                    {% set codexSandboxValue = codexBridgeConfig.sandbox or 'read-only' %}
                    {% set codexReasoningEffortValue = codexBridgeConfig.reasoning_effort or '' %}
                    {% set codexProfileValue = codexBridgeConfig.profile or '' %}
                    {% set codexPromptPreambleValue = codexBridgeConfig.prompt_preamble or '' %}
                    {% set clineCommandValue = clineBridgeConfig.command or 'cline' %}
                    {% set clineProviderValue = clineBridgeConfig.provider or '' %}
                    {% set clineCwdValue = clineBridgeConfig.cwd or '' %}
                    {% set clineThinkingValue = clineBridgeConfig.thinking or '' %}
                    {% set clineCompactionValue = clineBridgeConfig.compaction or 'basic' %}
                    {% set clineTimeoutSecondsValue = clineBridgeConfig.timeout_seconds if clineBridgeConfig.timeout_seconds is defined else 0 %}
                    {% set clineConfigValue = clineBridgeConfig.config or '' %}
                    {% set clineDataDirValue = clineBridgeConfig.data_dir or '' %}
                    {% set clinePromptPreambleValue = clineBridgeConfig.prompt_preamble or '' %}
                    {% set kimiCommandValue = kimiBridgeConfig.command or 'kimi' %}
                    {% set kimiCwdValue = kimiBridgeConfig.cwd or './tmp/kimi-bridge-cwd' %}
                    {% set kimiModelValue = kimiBridgeConfig.model or '' %}
                    {% set kimiThinkingValue = kimiBridgeConfig.thinking or '' %}
                    {% set kimiPromptPreambleValue = kimiBridgeConfig.prompt_preamble or '' %}
                    {% set aiSyspromptAppendValue = config.ai.sysprompt_append or '' %}
                    <div class="form-grid" data-ai-settings-grid>
                        <div class="form-group full-width">
                            <label for="ai-backend">Backend:</label>
                            <select id="ai-backend" name="ai.backend::string" required>
                                <option value="openai_compatible" {% if aiBackend == 'openai_compatible' %}selected{% endif %}>openai_compatible</option>
                                <option value="codex_cli_bridge" {% if aiBackend == 'codex_cli_bridge' %}selected{% endif %}>codex_cli_bridge</option>
                                <option value="cline_cli_bridge" {% if aiBackend == 'cline_cli_bridge' %}selected{% endif %}>cline_cli_bridge</option>
                                <option value="kimi_cli_bridge" {% if aiBackend == 'kimi_cli_bridge' %}selected{% endif %}>kimi_cli_bridge</option>
                            </select>
                            <span class="help-text">Choose the text-generation backend. Codex, Cline, and authenticated Kimi Code are available as local CLI bridges.</span>
                        </div>

                        <div class="form-group full-width"
                             data-ai-backend-section="openai_compatible"
                             {% if aiBackend != 'openai_compatible' %}hidden{% endif %}>
                            <label for="ai-endpoint">API Endpoint:</label>
                            <input type="url"
                                   id="ai-endpoint"
                                   name="ai.endpoint::string"
                                   value="{{ config.ai.endpoint }}"
                                   data-required-backend="openai_compatible">
                            <span class="help-text">OpenAI-compatible API endpoint URL</span>
                        </div>
                        
                        <div class="form-group full-width"
                             data-ai-backend-section="openai_compatible"
                             {% if aiBackend != 'openai_compatible' %}hidden{% endif %}>
                            <label for="ai-apiKey">API Key:</label>
                            <input type="password"
                                   id="ai-apiKey"
                                   name="ai.apiKey::string"
                                   value="{{ config.ai.apiKey }}"
                                   data-required-backend="openai_compatible">
                            <span class="help-text">Your API key (keep this secure!)</span>
                            <button type="button" class="toggle-password" onclick="togglePassword('ai-apiKey')">👁️</button>
                        </div>

                        <div class="form-group full-width"
                             data-ai-backend-section="codex_cli_bridge"
                             {% if aiBackend != 'codex_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-codex-command">Codex Command:</label>
                            <input type="text"
                                   id="ai-codex-command"
                                   name="ai.codex_bridge.command::string"
                                   value="{{ codexCommandValue }}"
                                   data-required-backend="codex_cli_bridge">
                            <span class="help-text">Command or absolute path used to launch Codex.</span>
                        </div>

                        <div class="form-group full-width"
                             data-ai-backend-section="codex_cli_bridge"
                             {% if aiBackend != 'codex_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-codex-home">Codex Home:</label>
                            <input type="text"
                                   id="ai-codex-home"
                                   name="ai.codex_bridge.home::string"
                                   value="{{ codexHomeValue }}">
                            <span class="help-text">State directory used by the bridge. Relative paths are resolved from the repo root. Resume modes only see sessions recorded under this same Codex home.</span>
                        </div>

                        <div class="form-group full-width"
                             data-ai-backend-section="cline_cli_bridge"
                             {% if aiBackend != 'cline_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-cline-command">Cline Command:</label>
                            <input type="text"
                                   id="ai-cline-command"
                                   name="ai.cline_bridge.command::string"
                                   value="{{ clineCommandValue }}"
                                   data-required-backend="cline_cli_bridge">
                            <span class="help-text">Command or absolute path used to launch Cline.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="cline_cli_bridge"
                             {% if aiBackend != 'cline_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-cline-provider">Cline Provider:</label>
                            <input type="text"
                                   id="ai-cline-provider"
                                   name="ai.cline_bridge.provider::string"
                                   value="{{ clineProviderValue }}">
                            <span class="help-text">Optional provider id passed to Cline. Blank uses Cline's saved default provider.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="cline_cli_bridge"
                             {% if aiBackend != 'cline_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-cline-cwd">Cline CWD:</label>
                            <input type="text"
                                   id="ai-cline-cwd"
                                   name="ai.cline_bridge.cwd::string"
                                   value="{{ clineCwdValue }}">
                            <span class="help-text">Optional working directory. Relative paths are resolved from the repo root.</span>
                        </div>

                        <div class="form-group full-width"
                             data-ai-backend-section="kimi_cli_bridge"
                             {% if aiBackend != 'kimi_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-kimi-command">Kimi Command:</label>
                            <input type="text"
                                   id="ai-kimi-command"
                                   name="ai.kimi_bridge.command::string"
                                   value="{{ kimiCommandValue }}"
                                   data-required-backend="kimi_cli_bridge">
                            <span class="help-text">Command or absolute path used to launch the already-authenticated Kimi Code CLI.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="kimi_cli_bridge"
                             {% if aiBackend != 'kimi_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-kimi-cwd">Kimi CWD:</label>
                            <input type="text"
                                   id="ai-kimi-cwd"
                                   name="ai.kimi_bridge.cwd::string"
                                   value="{{ kimiCwdValue }}">
                            <span class="help-text">Isolated working directory for fresh one-shot sessions. Relative paths resolve from the repo root.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="kimi_cli_bridge"
                             {% if aiBackend != 'kimi_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-kimi-model">Kimi Model Alias:</label>
                            <input type="text"
                                   id="ai-kimi-model"
                                   name="ai.kimi_bridge.model::string"
                                   value="{{ kimiModelValue }}">
                            <span class="help-text">Optional alias passed with `--model`. Blank uses Kimi's saved default model.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="kimi_cli_bridge"
                             {% if aiBackend != 'kimi_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-kimi-thinking">Kimi Thinking:</label>
                            <input type="text"
                                   id="ai-kimi-thinking"
                                   name="ai.kimi_bridge.thinking::string"
                                   value="{{ kimiThinkingValue }}">
                            <span class="help-text">Optional per-process thinking effort, such as low. Blank uses Kimi's saved default.</span>
                        </div>
                        
                        <div class="form-group full-width">
                            <label for="ai-model">Model:</label>
                            <select id="ai-model"
                                    name="ai.model::string"
                                    {% if aiBackend != 'kimi_cli_bridge' %}required{% endif %}>
                                {% if modelOptionsAreAdvertised and modelOptionsError %}
                                    <option value="" selected disabled>Local llama.cpp models unavailable</option>
                                {% endif %}
                                {% if aiBackend == 'kimi_cli_bridge' and not config.ai.model %}
                                    <option value="" selected>Kimi CLI default (shared model unused)</option>
                                {% endif %}
                                {% for option in modelOptions %}
                                    <option value="{{ option }}" {% if option == config.ai.model %}selected{% endif %}>{{ option }}</option>
                                {% endfor %}
                                {% if not modelOptionsAreAdvertised %}
                                <option value="__add_new__">Add New...</option>
                                {% endif %}
                            </select>
                            {% if modelOptionsAreAdvertised %}
                                <span class="help-text">Models advertised by the running local llama.cpp server.{% if modelOptionsError %} Query failed: {{ modelOptionsError }}{% endif %}</span>
                            {% else %}
                                <span class="help-text">Select the default AI model. Kimi uses the separate optional alias above or its saved CLI default.</span>
                            {% endif %}
                        </div>

                        <div class="form-group full-width">
                            <label for="ai-unload-during-image-generation">Unload During Image Generation:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden"
                                       name="ai.unload_during_image_generation::boolean"
                                       value="false">
                                <input type="checkbox"
                                       id="ai-unload-during-image-generation"
                                       name="ai.unload_during_image_generation::boolean"
                                       value="true"
                                       {% if config.ai.unload_during_image_generation === true %}checked{% endif %}>
                            </div>
                            <span class="help-text">For a llama.cpp router plus ComfyUI: finish queued image-prompt writing, unload the LLM while all queued images render, ask ComfyUI to free its models, then reload the LLM. Other text prompts wait until reload completes.</span>
                        </div>

                        <div class="form-group full-width">
                            <label for="ai-terminate-during-image-generation">Terminate During Image Generation:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden"
                                       name="ai.terminate_during_image_generation::boolean"
                                       value="false">
                                <input type="checkbox"
                                       id="ai-terminate-during-image-generation"
                                       name="ai.terminate_during_image_generation::boolean"
                                       value="true"
                                       {% if config.ai.terminate_during_image_generation === true %}checked{% endif %}>
                            </div>
                            <span class="help-text">Additionally terminate the game-managed local llama.cpp process while ComfyUI renders, clear ComfyUI VRAM, then restart the script. This cannot be combined with router unloading.</span>
                        </div>

                        <div class="form-group full-width">
                            <label for="ai-local-startup-script-path">Local llama.cpp Startup Script:</label>
                            <input type="text"
                                   id="ai-local-startup-script-path"
                                   name="ai.local_startup_script_path::string"
                                   value="{{ config.ai.local_startup_script_path or '' }}"
                                   placeholder="/absolute/path/to/start-llama.sh">
                            <span class="help-text">When nonblank, the game automatically starts and owns this script regardless of the image-unload setting. Relative paths resolve from the AI RPG project directory, and the file must be executable.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="codex_cli_bridge"
                             {% if aiBackend != 'codex_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-codex-sessionMode">Codex Session Mode:</label>
                            <select id="ai-codex-sessionMode" name="ai.codex_bridge.session_mode::string">
                                <option value="fresh" {% if codexSessionModeValue == 'fresh' %}selected{% endif %}>fresh</option>
                                <option value="resume_last" {% if codexSessionModeValue == 'resume_last' %}selected{% endif %}>resume_last</option>
                                <option value="resume_id" {% if codexSessionModeValue == 'resume_id' %}selected{% endif %}>resume_id</option>
                            </select>
                            <span class="help-text">`fresh` is the safest default. The resume modes target an existing Codex session.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="codex_cli_bridge"
                             {% if aiBackend != 'codex_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-codex-sandbox">Codex Sandbox:</label>
                            <select id="ai-codex-sandbox" name="ai.codex_bridge.sandbox::string">
                                <option value="read-only" {% if codexSandboxValue == 'read-only' %}selected{% endif %}>read-only</option>
                                <option value="workspace-write" {% if codexSandboxValue == 'workspace-write' %}selected{% endif %}>workspace-write</option>
                                <option value="danger-full-access" {% if codexSandboxValue == 'danger-full-access' %}selected{% endif %}>danger-full-access</option>
                            </select>
                            <span class="help-text">Applies only to fresh Codex bridge runs.</span>
                        </div>

                        <div class="form-group full-width"
                             data-ai-backend-section="codex_cli_bridge"
                             data-codex-session-mode-section="resume_id"
                             {% if aiBackend != 'codex_cli_bridge' or codexSessionModeValue != 'resume_id' %}hidden{% endif %}>
                            <label for="ai-codex-sessionId">Codex Session ID:</label>
                            <input type="text"
                                   id="ai-codex-sessionId"
                                   name="ai.codex_bridge.session_id::string"
                                   value="{{ codexBridgeConfig.session_id }}"
                                   data-required-backend="codex_cli_bridge"
                                   data-required-codex-session-mode="resume_id">
                            <span class="help-text">Required only when the bridge should resume a specific Codex session.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="codex_cli_bridge"
                             {% if aiBackend != 'codex_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-codex-reasoningEffort">Codex Reasoning Effort:</label>
                            <select id="ai-codex-reasoningEffort" name="ai.codex_bridge.reasoning_effort::string">
                                <option value="" {% if codexReasoningEffortValue == '' %}selected{% endif %}>default</option>
                                <option value="none" {% if codexReasoningEffortValue == 'none' %}selected{% endif %}>none</option>
                                <option value="minimal" {% if codexReasoningEffortValue == 'minimal' %}selected{% endif %}>minimal</option>
                                <option value="low" {% if codexReasoningEffortValue == 'low' %}selected{% endif %}>low</option>
                                <option value="medium" {% if codexReasoningEffortValue == 'medium' %}selected{% endif %}>medium</option>
                                <option value="high" {% if codexReasoningEffortValue == 'high' %}selected{% endif %}>high</option>
                                <option value="xhigh" {% if codexReasoningEffortValue == 'xhigh' %}selected{% endif %}>xhigh</option>
                            </select>
                            <span class="help-text">Optional `model_reasoning_effort` override passed through to Codex. `none` is the lowest supported setting.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="codex_cli_bridge"
                             {% if aiBackend != 'codex_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-codex-profile">Codex Profile:</label>
                            <input type="text"
                                   id="ai-codex-profile"
                                   name="ai.codex_bridge.profile::string"
                                   value="{{ codexProfileValue }}">
                            <span class="help-text">Optional Codex config profile to pass through to the bridge.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="codex_cli_bridge"
                             {% if aiBackend != 'codex_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-codex-skipGitRepoCheck">Skip Git Repo Check:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="ai.codex_bridge.skip_git_repo_check::boolean" value="false">
                                <input type="checkbox"
                                       id="ai-codex-skipGitRepoCheck"
                                       name="ai.codex_bridge.skip_git_repo_check::boolean"
                                       value="true"
                                       {% if codexBridgeConfig.skip_git_repo_check %}checked{% endif %}>
                            </div>
                            <span class="help-text">Useful when the bridge should run even if Codex objects to the current git state.</span>
                        </div>

                        <div class="form-group full-width"
                             data-ai-backend-section="codex_cli_bridge"
                             {% if aiBackend != 'codex_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-codex-promptPreamble">Codex Prompt Preamble:</label>
                            <textarea id="ai-codex-promptPreamble"
                                      name="ai.codex_bridge.prompt_preamble::string"
                                      rows="4">{{ codexPromptPreambleValue }}</textarea>
                            <span class="help-text">Optional instructions prepended ahead of the bridge wrapper prompt.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="cline_cli_bridge"
                             {% if aiBackend != 'cline_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-cline-thinking">Cline Thinking:</label>
                            <select id="ai-cline-thinking" name="ai.cline_bridge.thinking::string">
                                <option value="" {% if clineThinkingValue == '' %}selected{% endif %}>default</option>
                                <option value="none" {% if clineThinkingValue == 'none' %}selected{% endif %}>none</option>
                                <option value="low" {% if clineThinkingValue == 'low' %}selected{% endif %}>low</option>
                                <option value="medium" {% if clineThinkingValue == 'medium' %}selected{% endif %}>medium</option>
                                <option value="high" {% if clineThinkingValue == 'high' %}selected{% endif %}>high</option>
                                <option value="xhigh" {% if clineThinkingValue == 'xhigh' %}selected{% endif %}>xhigh</option>
                            </select>
                            <span class="help-text">Optional Cline thinking level.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="cline_cli_bridge"
                             {% if aiBackend != 'cline_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-cline-compaction">Cline Compaction:</label>
                            <select id="ai-cline-compaction" name="ai.cline_bridge.compaction::string">
                                <option value="basic" {% if clineCompactionValue == 'basic' %}selected{% endif %}>basic</option>
                                <option value="agentic" {% if clineCompactionValue == 'agentic' %}selected{% endif %}>agentic</option>
                                <option value="off" {% if clineCompactionValue == 'off' %}selected{% endif %}>off</option>
                            </select>
                            <span class="help-text">Cline context compaction mode.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="cline_cli_bridge"
                             {% if aiBackend != 'cline_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-cline-timeoutSeconds">Cline Timeout (seconds):</label>
                            <input type="number"
                                   id="ai-cline-timeoutSeconds"
                                   name="ai.cline_bridge.timeout_seconds::number"
                                   value="{{ clineTimeoutSecondsValue }}"
                                   min="0"
                                   step="1">
                            <span class="help-text">Optional total Cline timeout. 0 leaves Cline without a total timeout.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="cline_cli_bridge"
                             {% if aiBackend != 'cline_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-cline-config">Cline Config Directory:</label>
                            <input type="text"
                                   id="ai-cline-config"
                                   name="ai.cline_bridge.config::string"
                                   value="{{ clineConfigValue }}">
                            <span class="help-text">Optional Cline configuration directory.</span>
                        </div>

                        <div class="form-group"
                             data-ai-backend-section="cline_cli_bridge"
                             {% if aiBackend != 'cline_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-cline-dataDir">Cline Data Directory:</label>
                            <input type="text"
                                   id="ai-cline-dataDir"
                                   name="ai.cline_bridge.data_dir::string"
                                   value="{{ clineDataDirValue }}">
                            <span class="help-text">Optional isolated Cline data directory.</span>
                        </div>

                        <div class="form-group full-width"
                             data-ai-backend-section="cline_cli_bridge"
                             {% if aiBackend != 'cline_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-cline-promptPreamble">Cline Prompt Preamble:</label>
                            <textarea id="ai-cline-promptPreamble"
                                      name="ai.cline_bridge.prompt_preamble::string"
                                      rows="4">{{ clinePromptPreambleValue }}</textarea>
                            <span class="help-text">Optional instructions prepended ahead of the Cline bridge wrapper prompt.</span>
                        </div>

                        <div class="form-group full-width"
                             data-ai-backend-section="kimi_cli_bridge"
                             {% if aiBackend != 'kimi_cli_bridge' %}hidden{% endif %}>
                            <label for="ai-kimi-promptPreamble">Kimi Prompt Preamble:</label>
                            <textarea id="ai-kimi-promptPreamble"
                                      name="ai.kimi_bridge.prompt_preamble::string"
                                      rows="4">{{ kimiPromptPreambleValue }}</textarea>
                            <span class="help-text">Optional instructions prepended ahead of the Kimi bridge wrapper prompt.</span>
                        </div>

                        <div class="form-group full-width">
                            <label for="model-options">Model Swap Options (JSON Array):</label>
                            <textarea id="model-options" name="model_swap_options::string-array" rows="4">{{ modelOptions | dump }}</textarea>
                            <span class="help-text">{% if modelOptionsAreAdvertised %}Current model IDs advertised by local llama.cpp.{% else %}Edit as JSON array of model names, e.g. ["model-a","model-b"]{% endif %}</span>
                        </div>

                        <div class="form-group full-width">
                            <label for="ai-syspromptAppend">System Prompt Append:</label>
                            <textarea id="ai-syspromptAppend"
                                      name="ai.sysprompt_append::string"
                                      rows="4">{{ aiSyspromptAppendValue }}</textarea>
                            <span class="help-text">Optional model-specific system instructions appended to every outbound prompt.</span>
                        </div>
                        
                        <div class="form-group">
                            <label for="ai-maxTokens">Max Tokens:</label>
                            <input type="number" id="ai-maxTokens" name="ai.maxTokens::int" value="{{ config.ai.maxTokens }}" min="1">
                            <span class="help-text">Maximum response length</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-lowTemperature">Low Temperature:</label>
                            <input type="number" id="ai-lowTemperature" name="ai.lowTemperature::number" value="{{ config.ai.lowTemperature }}" min="0" max="2" step="0.1">
                            <span class="help-text">Optional lower bound for temperature adjustments</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-temperature">Temperature:</label>
                            <input type="number" id="ai-temperature" name="ai.temperature::number" value="{{ config.ai.temperature }}" min="0" max="2" step="0.1">
                            <span class="help-text">Creativity level (0.0 - 2.0)</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-topP">Top P (Nucleus Sampling):</label>
                            <input type="number" id="ai-topP" name="ai.top_p::number" value="{{ config.ai.top_p }}" min="0" max="1" step="0.05">
                            <span class="help-text">Token selection diversity (0.0 - 1.0)</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-highTemperature">High Temperature:</label>
                            <input type="number" id="ai-highTemperature" name="ai.highTemperature::number" value="{{ config.ai.highTemperature }}" min="0" max="2" step="0.1">
                            <span class="help-text">Optional upper bound for temperature adjustments</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-baseTimeoutSeconds">Base Timeout (seconds):</label>
                            <input type="number" id="ai-baseTimeoutSeconds" name="ai.baseTimeoutSeconds::int" value="{{ config.ai.baseTimeoutSeconds }}" min="1" step="1">
                            <span class="help-text">Base timeout for AI requests</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-retryAttempts">Retry Attempts:</label>
                            <input type="number" id="ai-retryAttempts" name="ai.retryAttempts::int" value="{{ config.ai.retryAttempts }}" min="0" step="1">
                            <span class="help-text">Number of retries before failing a request</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-maxConcurrentRequests">Max Concurrent Requests:</label>
                            <input type="number" id="ai-maxConcurrentRequests" name="ai.max_concurrent_requests::int" value="{{ config.ai.max_concurrent_requests }}" min="1" step="1">
                            <span class="help-text">Concurrent AI request limit</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-stream">Streaming:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="ai.stream::boolean" value="false">
                                <input type="checkbox" id="ai-stream" name="ai.stream::boolean" value="true" {% if config.ai.stream %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enable streaming if the API supports it</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-streamStartTimeout">Stream Start Timeout (seconds):</label>
                            <input type="number" id="ai-streamStartTimeout" name="ai.stream_start_timeout::int" value="{{ config.ai.stream_start_timeout }}" min="1" step="1">
                            <span class="help-text">Time to wait for stream to begin</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-streamContinueTimeout">Stream Continue Timeout (seconds):</label>
                            <input type="number" id="ai-streamContinueTimeout" name="ai.stream_continue_timeout::int" value="{{ config.ai.stream_continue_timeout }}" min="1" step="1">
                            <span class="help-text">Time to wait before a started stream is considered stalled</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-incrementStartTimeout">Increment Start Timeout (seconds):</label>
                            <input type="number" id="ai-incrementStartTimeout" name="ai.increment_start_timeout::int" value="{{ config.ai.increment_start_timeout }}" min="0" step="1">
                            <span class="help-text">Start timeout increase per retry</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-incrementContinueTimeout">Increment Continue Timeout (seconds):</label>
                            <input type="number" id="ai-incrementContinueTimeout" name="ai.increment_continue_timeout::int" value="{{ config.ai.increment_continue_timeout }}" min="0" step="1">
                            <span class="help-text">Continue timeout increase per retry</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-supressSeed">Suppress Seed:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="ai.supress_seed::boolean" value="false">
                                <input type="checkbox" id="ai-supressSeed" name="ai.supress_seed::boolean" value="true" {% if config.ai.supress_seed %}checked{% endif %}>
                            </div>
                            <span class="help-text">Disable seed argument for compatible APIs</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-debug">Debug:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="ai.debug::boolean" value="false">
                                <input type="checkbox" id="ai-debug" name="ai.debug::boolean" value="true" {% if config.ai.debug %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enable AI request logging</span>
                        </div>

                        <div class="form-group">
                            <label for="ai-reasoning">Reasoning:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="ai.reasoning::boolean" value="false">
                                <input type="checkbox" id="ai-reasoning" name="ai.reasoning::boolean" value="true" {% if config.ai.reasoning %}checked{% endif %}>
                            </div>
                            <span class="help-text">Request reasoning data when supported</span>
                        </div>
                    </div>
                </div>
                <div class="form-actions form-actions--panel">
                    <button type="submit" class="btn btn-primary">💾 Save AI Settings</button>
                    <button type="button" class="btn btn-secondary" onclick="testConnection()">🔗 Test Connection</button>
                </div>
            </section>

            <section id="config-tab-story"
                     class="config-tab-panel"
                     data-config-tab-panel="story"
                     aria-labelledby="config-tab-button-story"
                     role="tabpanel"
                     hidden>
                <div class="config-sections">

                <!-- Memory & Autosaves -->
                <div class="config-section">
                    <h2>🧠 Memory &amp; Autosaves</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="max-memories-to-recall">Max Memories to Recall:</label>
                            <input type="number" id="max-memories-to-recall" name="max_memories_to_recall::int" value="{{ config.max_memories_to_recall }}" min="0" step="1">
                            <span class="help-text">Number of memories pulled into context</span>
                        </div>

                        <div class="form-group">
                            <label for="party-generate-memory-interval">Party Memory Interval:</label>
                            <input type="number" id="party-generate-memory-interval" name="party_generate_memory_interval::int" value="{{ config.party_generate_memory_interval }}" min="1" step="1">
                            <span class="help-text">Turns between party memory generation</span>
                        </div>

                        <div class="form-group">
                            <label for="autosaves-to-retain">Autosaves to Retain:</label>
                            <input type="number" id="autosaves-to-retain" name="autosaves_to_retain::int" value="{{ config.autosaves_to_retain }}" min="0" step="1">
                            <span class="help-text">Set to 0 to disable autosaves</span>
                        </div>
                    </div>
                </div>

                <!-- Summaries -->
                <div class="config-section">
                    <h2>🗂️ Summaries</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="summaries-enabled">Enable Summaries:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="summaries.enabled::boolean" value="false">
                                <input type="checkbox" id="summaries-enabled" name="summaries.enabled::boolean" value="true" {% if config.summaries.enabled %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enable automatic summarization</span>
                        </div>

                        <div class="form-group">
                            <label for="summaries-on-load">Summarize on Load:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="summaries.summarize_on_load::boolean" value="false">
                                <input type="checkbox" id="summaries-on-load" name="summaries.summarize_on_load::boolean" value="true" {% if config.summaries.summarize_on_load %}checked{% endif %}>
                            </div>
                            <span class="help-text">Summarize logs on load</span>
                        </div>

                        <div class="form-group">
                            <label for="summaries-batch-size">Batch Size:</label>
                            <input type="number" id="summaries-batch-size" name="summaries.batch_size::int" value="{{ config.summaries.batch_size }}" min="1" step="1">
                            <span class="help-text">Entries per summary batch</span>
                        </div>

                        <div class="form-group">
                            <label for="summaries-word-length">Summary Word Length:</label>
                            <input type="number" id="summaries-word-length" name="summaries.summary_word_length::int" value="{{ config.summaries.summary_word_length }}" min="1" step="1">
                            <span class="help-text">Target word length per summary line</span>
                        </div>

                        <div class="form-group">
                            <label for="summaries-max-unsummarized">Max Unsummarized Entries:</label>
                            <input type="number" id="summaries-max-unsummarized" name="summaries.max_unsummarized_log_entries::int" value="{{ config.summaries.max_unsummarized_log_entries }}" min="0" step="1">
                            <span class="help-text">Unsummarized log cap</span>
                        </div>

                        <div class="form-group">
                            <label for="summaries-max-summarized">Max Summarized Entries:</label>
                            <input type="number" id="summaries-max-summarized" name="summaries.max_summarized_log_entries::int" value="{{ config.summaries.max_summarized_log_entries }}" min="0" step="1">
                            <span class="help-text">Summarized log cap</span>
                        </div>
                    </div>
                </div>


                <!-- Random Events -->
                <div class="config-section">
                    <h2>🎲 Random Events</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="random-events-enabled">Enabled:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="random_event_frequency.enabled::boolean" value="false">
                                <input type="checkbox" id="random-events-enabled" name="random_event_frequency.enabled::boolean" value="true" {% if config.random_event_frequency.enabled %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enable random event rolls</span>
                        </div>

                        <div class="form-group">
                            <label for="random-events-multiplier">Frequency Multiplier:</label>
                            <input type="number" id="random-events-multiplier" name="random_event_frequency_multiplier::number" value="{{ config.random_event_frequency_multiplier }}" min="0.01" step="0.01">
                            <span class="help-text">Divides the roll (1 = no change, 2 = twice as likely)</span>
                        </div>

                        <div class="form-group">
                            <label for="random-events-common">Common Frequency:</label>
                            <input type="number" id="random-events-common" name="random_event_frequency.common::number" value="{{ config.random_event_frequency.common }}" min="0" max="1" step="0.01">
                            <span class="help-text">Chance per turn for common events</span>
                        </div>

                        <div class="form-group">
                            <label for="random-events-rare">Rare Frequency:</label>
                            <input type="number" id="random-events-rare" name="random_event_frequency.rare::number" value="{{ config.random_event_frequency.rare }}" min="0" max="1" step="0.01">
                            <span class="help-text">Chance per turn for rare events</span>
                        </div>

                        <div class="form-group">
                            <label for="random-events-region">Region-Specific Frequency:</label>
                            <input type="number" id="random-events-region" name="random_event_frequency.regionSpecific::number" value="{{ config.random_event_frequency.regionSpecific }}" min="0" max="1" step="0.01">
                            <span class="help-text">Chance per turn for region events</span>
                        </div>

                        <div class="form-group">
                            <label for="random-events-location">Location-Specific Frequency:</label>
                            <input type="number" id="random-events-location" name="random_event_frequency.locationSpecific::number" value="{{ config.random_event_frequency.locationSpecific }}" min="0" max="1" step="0.01">
                            <span class="help-text">Chance per turn for location events</span>
                        </div>
                    </div>
                </div>

                <!-- Event Checks & Plausibility -->
                <div class="config-section">
                    <h2>🧪 Event Checks &amp; Plausibility</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="event-checks-enabled">Event Checks:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="event_checks.enabled::boolean" value="false">
                                <input type="checkbox" id="event-checks-enabled" name="event_checks.enabled::boolean" value="true" {% if config.event_checks.enabled %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enable event checks for story effects</span>
                        </div>

                        <div class="form-group">
                            <label for="event-checks-use-xml">XML Event Pipeline:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="event_checks.use_xml::boolean" value="false">
                                <input type="checkbox" id="event-checks-use-xml" name="event_checks.use_xml::boolean" value="true" {% if config.event_checks.use_xml is not defined or config.event_checks.use_xml %}checked{% endif %}>
                            </div>
                            <span class="help-text">Use the single XML event prompt instead of grouped legacy event checks</span>
                        </div>

                        <div class="form-group">
                            <label for="plausibility-checks-enabled">Plausibility Checks:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="plausibility_checks.enabled::boolean" value="false">
                                <input type="checkbox" id="plausibility-checks-enabled" name="plausibility_checks.enabled::boolean" value="true" {% if config.plausibility_checks.enabled %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enable plausibility and combat checks</span>
                        </div>

                        <div class="form-group">
                            <label for="quest-completion-prose-enabled">Quest Completion Prose:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="quest_completion_prose.enabled::boolean" value="false">
                                <input type="checkbox" id="quest-completion-prose-enabled" name="quest_completion_prose.enabled::boolean" value="true" {% if config.quest_completion_prose.enabled %}checked{% endif %}>
                            </div>
                            <span class="help-text">Generate quest completion prose</span>
                        </div>

                        <div class="form-group">
                            <label for="housekeeping-interval">Housekeeping Interval:</label>
                            <input type="number" id="housekeeping-interval" name="housekeeping.interval::int" value="{{ config.housekeeping.interval | default(1) }}" min="1" step="1">
                            <span class="help-text">Eligible top-level event checks between automatic housekeeping prompts</span>
                        </div>
                    </div>
                </div>

                <!-- Tonal Scale Evaluation -->
                <div class="config-section" id="tonal-scale-evaluation-settings">
                    <h2>🎚️ Tonal Scale Evaluation</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="tonal-scale-evaluation-enabled">Enabled:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="tonal_scale_evaluation.enabled::boolean" value="false">
                                <input type="checkbox"
                                       id="tonal-scale-evaluation-enabled"
                                       name="tonal_scale_evaluation.enabled::boolean"
                                       value="true"
                                       {% if config.tonal_scale_evaluation.enabled is not defined or config.tonal_scale_evaluation.enabled %}checked{% endif %}>
                            </div>
                            <span class="help-text">Run automatic tonal-scale checks after completed player-action turns</span>
                        </div>

                        <div class="form-group">
                            <label for="tonal-scale-evaluation-interval">Interval:</label>
                            <input type="number"
                                   id="tonal-scale-evaluation-interval"
                                   name="tonal_scale_evaluation.interval::int"
                                   value="{{ config.tonal_scale_evaluation.interval | default(5) }}"
                                   min="1"
                                   step="1">
                            <span class="help-text">Completed player-action turns between automatic tonal-scale checks</span>
                        </div>
                    </div>
                </div>

                </div>
                <div class="form-actions form-actions--panel">
                    <button type="submit" class="btn btn-primary">💾 Save Story Settings</button>
                </div>
            </section>

            <section id="config-tab-gameplay"
                     class="config-tab-panel"
                     data-config-tab-panel="gameplay"
                     aria-labelledby="config-tab-button-gameplay"
                     role="tabpanel"
                     hidden>
                <div class="config-sections">

                <!-- World Generation -->
                <div class="config-section">
                    <h2>🗺️ World Generation</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="regions-min-locations">Min Locations per Region:</label>
                            <input type="number" id="regions-min-locations" name="regions.minLocations::int" value="{{ config.regions.minLocations }}" min="1" step="1">
                            <span class="help-text">Minimum locations created per region</span>
                        </div>

                        <div class="form-group">
                            <label for="regions-max-locations">Max Locations per Region:</label>
                            <input type="number" id="regions-max-locations" name="regions.maxLocations::int" value="{{ config.regions.maxLocations }}" min="1" step="1">
                            <span class="help-text">Maximum locations created per region</span>
                        </div>

                        <div class="form-group">
                            <label for="locations-max-npcs">Max NPCs per Location:</label>
                            <input type="number" id="locations-max-npcs" name="locations.maxNpcs::int" value="{{ config.locations.maxNpcs }}" min="0" step="1">
                            <span class="help-text">Maximum NPCs created per location</span>
                        </div>

                        <div class="form-group">
                            <label for="locations-max-hostiles">Max Hostiles per Location:</label>
                            <input type="number" id="locations-max-hostiles" name="locations.maxHostiles::int" value="{{ config.locations.maxHostiles }}" min="0" step="1">
                            <span class="help-text">Maximum hostile NPCs per location</span>
                        </div>

                        <div class="form-group">
                            <label for="locations-max-items">Max Items per Location:</label>
                            <input type="number" id="locations-max-items" name="locations.maxItems::int" value="{{ config.locations.maxItems }}" min="0" step="1">
                            <span class="help-text">Maximum items per location</span>
                        </div>

                        <div class="form-group">
                            <label for="locations-max-scenery">Max Scenery per Location:</label>
                            <input type="number" id="locations-max-scenery" name="locations.maxScenery::int" value="{{ config.locations.maxScenery }}" min="0" step="1">
                            <span class="help-text">Maximum scenery per location</span>
                        </div>

                        <div class="form-group">
                            <label for="locations-level-variation">Location Level Variation:</label>
                            <input type="number" id="locations-level-variation" name="locations.levelVariation::int" value="{{ config.locations.levelVariation }}" min="0" step="1">
                            <span class="help-text">Level variance for locations</span>
                        </div>
                    </div>
                </div>

                <!-- NPC Turns -->
                <div class="config-section">
                    <h2>🧍 NPC Turns</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="npc-turns-enabled">Enabled:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="npc_turns.enabled::boolean" value="false">
                                <input type="checkbox" id="npc-turns-enabled" name="npc_turns.enabled::boolean" value="true" {% if config.npc_turns.enabled %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enable NPC turns outside combat</span>
                        </div>

                        <div class="form-group">
                            <label for="npc-turns-max">Max NPCs to Act:</label>
                            <input type="number" id="npc-turns-max" name="npc_turns.maxNpcsToAct::int" value="{{ config.npc_turns.maxNpcsToAct }}" min="0" step="1">
                            <span class="help-text">Maximum NPCs that can act per turn</span>
                        </div>

                        <div class="form-group">
                            <label for="npc-turns-frequency">NPC Turn Frequency:</label>
                            <input type="number" id="npc-turns-frequency" name="npc_turns.npcTurnFrequency::number" value="{{ config.npc_turns.npcTurnFrequency }}" min="0" max="1" step="0.01">
                            <span class="help-text">Chance per turn to run NPC turns</span>
                        </div>
                    </div>
                </div>

                <!-- Combat NPC Turns -->
                <div class="config-section">
                    <h2>⚔️ Combat NPC Turns</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="combat-npc-turns-enabled">Enabled:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="combat_npc_turns.enabled::boolean" value="false">
                                <input type="checkbox" id="combat-npc-turns-enabled" name="combat_npc_turns.enabled::boolean" value="true" {% if config.combat_npc_turns.enabled %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enable NPC turns in combat</span>
                        </div>

                        <div class="form-group">
                            <label for="combat-npc-turns-max">Max NPCs to Act:</label>
                            <input type="number" id="combat-npc-turns-max" name="combat_npc_turns.maxNpcsToAct::int" value="{{ config.combat_npc_turns.maxNpcsToAct }}" min="0" step="1">
                            <span class="help-text">Maximum NPCs that can act in combat</span>
                        </div>

                        <div class="form-group">
                            <label for="combat-npc-turns-frequency">NPC Turn Frequency:</label>
                            <input type="number" id="combat-npc-turns-frequency" name="combat_npc_turns.npcTurnFrequency::number" value="{{ config.combat_npc_turns.npcTurnFrequency }}" min="0" max="1" step="0.01">
                            <span class="help-text">Chance per turn to run combat NPC turns</span>
                        </div>
                    </div>
                </div>

                <!-- Quests -->
                <div class="config-section">
                    <h2>📜 Quests</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="quests-enabled">Enabled:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="quests.enabled::boolean" value="false">
                                <input type="checkbox" id="quests-enabled" name="quests.enabled::boolean" value="true" {% if config.quests.enabled %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enable quest generation</span>
                        </div>

                        <div class="form-group">
                            <label for="quest-checks-enabled">Quest Checks:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="quest_checks.enabled::boolean" value="false">
                                <input type="checkbox" id="quest-checks-enabled" name="quest_checks.enabled::boolean" value="true" {% if config.quest_checks.enabled %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enable quest completion checks</span>
                        </div>

                        <div class="form-group">
                            <label for="quest-checks-interval">Quest Check Interval:</label>
                            <input type="number" id="quest-checks-interval" name="quest_checks.interval::int" value="{{ config.quest_checks.interval | default(1) }}" min="1" step="1">
                            <span class="help-text">Eligible checks with active quests between quest-check prompts</span>
                        </div>
                    </div>
                </div>

                <!-- Gameplay Tuning -->
                <div class="config-section">
                    <h2>⚙️ Gameplay Tuning</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="base-weapon-damage">Base Weapon Damage:</label>
                            <input type="number" id="base-weapon-damage" name="baseWeaponDamage::int" value="{{ config.baseWeaponDamage }}" min="0" step="1">
                            <span class="help-text">Base weapon damage used in combat scaling</span>
                        </div>

                        <div class="form-group">
                            <label for="base-health-per-level">Base Health per Level:</label>
                            <input type="number" id="base-health-per-level" name="baseHealthPerLevel::int" value="{{ config.baseHealthPerLevel }}" min="0" step="1">
                            <span class="help-text">Health per level used for player scaling</span>
                        </div>

                        <div class="form-group">
                            <label for="repetition-buster">Repetition Buster:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="repetition_buster::boolean" value="false">
                                <input type="checkbox" id="repetition-buster" name="repetition_buster::boolean" value="true" {% if config.repetition_buster %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enable repetition buster logic</span>
                        </div>

                        <div class="form-group">
                            <label for="debug-tool-calls">Debug Tool Calls:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="debug_tool_calls::boolean" value="false">
                                <input type="checkbox" id="debug-tool-calls" name="debug_tool_calls::boolean" value="true" {% if config.debug_tool_calls %}checked{% endif %}>
                            </div>
                            <span class="help-text">Show live prose-prompt tool call diagnostics in chat</span>
                        </div>

                        <div class="form-group">
                            <label for="show-hidden-notes">Show Hidden Notes in Story Tools:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="show_hidden_notes::boolean" value="false">
                                <input type="checkbox" id="show-hidden-notes" name="show_hidden_notes::boolean" value="true" {% if config.show_hidden_notes %}checked{% endif %}>
                            </div>
                            <span class="help-text">Show player-action &lt;hidden&gt; notes in Story Tools full-history view; Adventure chat always filters them</span>
                        </div>

                        <div class="form-group">
                            <label for="use-legacy-prompt-checks">Legacy Prompt Checks:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="use_legacy_prompt_checks::boolean" value="false">
                                <input type="checkbox" id="use-legacy-prompt-checks" name="use_legacy_prompt_checks::boolean" value="true" {% if config.use_legacy_prompt_checks %}checked{% endif %}>
                            </div>
                            <span class="help-text">Use separate attack and skill-check prompts instead of prose-prompt tool calls</span>
                        </div>

                        <div class="form-group">
                            <label for="prose-length">Prose Length:</label>
                            <input type="text" id="prose-length" name="prose_length::string" value="{{ config.prose_length }}">
                            <span class="help-text">Sentence guidance for responses</span>
                        </div>

                        <div class="form-group">
                            <label for="events-to-check">Events to Check Concurrently:</label>
                            <input type="number" id="events-to-check" name="events_to_check_concurrently::int" value="{{ config.events_to_check_concurrently }}" min="0" step="1">
                            <span class="help-text">Leave blank to check all events</span>
                        </div>

                        <div class="form-group">
                            <label for="check-move-plausibility">Check Move Plausibility:</label>
                            <select id="check-move-plausibility" name="check_move_plausibility::string">
                                {% set plausibilityOption = config.check_move_plausibility or 'never' %}
                                <option value="never" {% if plausibilityOption == 'never' %}selected{% endif %}>never</option>
                                <option value="unexplored_regions" {% if plausibilityOption == 'unexplored_regions' %}selected{% endif %}>unexplored_regions</option>
                                <option value="unexplored_locations" {% if plausibilityOption == 'unexplored_locations' %}selected{% endif %}>unexplored_locations</option>
                                <option value="always" {% if plausibilityOption == 'always' %}selected{% endif %}>always</option>
                            </select>
                            <span class="help-text">When to run movement plausibility checks</span>
                        </div>
                    </div>
                </div>

                <!-- Generation Flags -->
                <div class="config-section">
                    <h2>🧰 Generation Flags</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="omit-npc-generation">Omit NPC Generation:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="omit_npc_generation::boolean" value="false">
                                <input type="checkbox" id="omit-npc-generation" name="omit_npc_generation::boolean" value="true" {% if config.omit_npc_generation %}checked{% endif %}>
                            </div>
                            <span class="help-text">Skip NPC generation for faster testing</span>
                        </div>

                        <div class="form-group">
                            <label for="omit-item-generation">Omit Item Generation:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="omit_item_generation::boolean" value="false">
                                <input type="checkbox" id="omit-item-generation" name="omit_item_generation::boolean" value="true" {% if config.omit_item_generation %}checked{% endif %}>
                            </div>
                            <span class="help-text">Skip item generation for faster testing</span>
                        </div>

                        <div class="form-group">
                            <label for="deduplicate-item-names">Deduplicate Item Names:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="deduplicate_item_names::boolean" value="false">
                                <input type="checkbox" id="deduplicate-item-names" name="deduplicate_item_names::boolean" value="true" {% if config.deduplicate_item_names %}checked{% endif %}>
                            </div>
                            <span class="help-text">Prevent duplicate item names</span>
                        </div>

                        <div class="form-group">
                            <label for="strict-xml-parsing">Strict XML Parsing:</label>
                            <div class="checkbox-wrapper">
                                <input type="hidden" name="strictXMLParsing::boolean" value="false">
                                <input type="checkbox" id="strict-xml-parsing" name="strictXMLParsing::boolean" value="true" {% if config.strictXMLParsing %}checked{% endif %}>
                            </div>
                            <span class="help-text">Enforce strict XML parsing on prompts</span>
                        </div>
                    </div>
                </div>
                
                <!-- Mod Configurations -->
                {% for mod in modConfigs %}
                <div class="config-section">
                    <h2>🧩 {{ mod.displayName }}</h2>
                    <div class="form-grid">
                        {% for key, schema in mod.schema %}
                        {% set fieldType = 'string' %}
                        {% if schema.type == 'number' %}
                            {% set fieldType = 'number' %}
                        {% elif schema.type == 'checkbox' %}
                            {% set fieldType = 'boolean' %}
                        {% endif %}
                        <div class="form-group {% if schema.fullWidth %}full-width{% endif %}">
                            <label for="mod-{{ mod.name }}-{{ key }}">{{ schema.label }}</label>
                            
                            {% if schema.type == 'select' %}
                                <select id="mod-{{ mod.name }}-{{ key }}" name="mods.{{ mod.name }}.{{ key }}::{{ fieldType }}">
                                    {% for option in schema.options %}
                                        <option value="{{ option }}" {% if option == mod.config[key] %}selected{% endif %}>{{ option }}</option>
                                    {% endfor %}
                                </select>
                            {% elif schema.type == 'modelSelect' %}
                                <select id="mod-{{ mod.name }}-{{ key }}" name="mods.{{ mod.name }}.{{ key }}::{{ fieldType }}">
                                    <option value="" {% if not mod.config[key] %}selected{% endif %}>Values Default ({{ config.ai.model }})</option>
                                    {% for option in modelOptions %}
                                        <option value="{{ option }}" {% if option == mod.config[key] %}selected{% endif %}>{{ option }}</option>
                                    {% endfor %}
                                </select>
                            {% elif schema.type == 'number' %}
                                <input type="number" 
                                       id="mod-{{ mod.name }}-{{ key }}" 
                                       name="mods.{{ mod.name }}.{{ key }}::{{ fieldType }}" 
                                       value="{{ mod.config[key] }}"
                                       {% if schema.min is defined %}min="{{ schema.min }}"{% endif %}
                                       {% if schema.max is defined %}max="{{ schema.max }}"{% endif %}
                                       {% if schema.step is defined %}step="{{ schema.step }}"{% endif %}>
                            {% elif schema.type == 'checkbox' %}
                                <div class="checkbox-wrapper">
                                    <input type="hidden" name="mods.{{ mod.name }}.{{ key }}::{{ fieldType }}" value="false">
                                    <input type="checkbox" 
                                           id="mod-{{ mod.name }}-{{ key }}" 
                                           name="mods.{{ mod.name }}.{{ key }}::{{ fieldType }}" 
                                           value="true"
                                           {% if mod.config[key] %}checked{% endif %}>
                                </div>
                            {% else %}
                                <input type="text" 
                                       id="mod-{{ mod.name }}-{{ key }}" 
                                       name="mods.{{ mod.name }}.{{ key }}::{{ fieldType }}" 
                                       value="{{ mod.config[key] }}">
                            {% endif %}
                            
                            {% if schema.description %}
                                <span class="help-text">{{ schema.description }}</span>
                            {% endif %}
                        </div>
                        {% endfor %}
                    </div>
                </div>
                {% endfor %}
                </div>

                <!-- Action Buttons -->
                <div class="form-actions form-actions--panel">
                    <button type="submit" class="btn btn-primary">💾 Save Gameplay Settings</button>
                </div>
                
            </section>

            <section id="config-tab-images"
                     class="config-tab-panel"
                     data-config-tab-panel="images"
                     aria-labelledby="config-tab-button-images"
                     role="tabpanel"
                     hidden>
                <div class="image-workflow-editor config-sections config-sections--single-column">
                        <div class="config-section">
                            <h2>🎨 Image Workflows</h2>
                            <p class="help-text">Choose the model family and rendering parameters used for new images and edits.</p>
                            <div class="image-workflow-subtabs" role="tablist" aria-label="Image workflow mode">
                                <button type="button" class="image-workflow-subtab is-active" data-image-workflow-subtab="generation" role="tab" aria-selected="true">Generate</button>
                                <button type="button" class="image-workflow-subtab" data-image-workflow-subtab="edit" role="tab" aria-selected="false">Edit</button>
                            </div>
                        </div>
                        {{ workflowTab('generation', 'imagegen.workflow.generation::json', '', false, config.imagegen.workflow.generation or {}, false) }}
                        {{ workflowTab('edit', 'imagegen.workflow.edit::json', '', false, config.imagegen.workflow.edit or {}, false) }}
                </div>
                <div class="form-actions form-actions--panel">
                    <button type="submit" class="btn btn-primary">💾 Save Image Settings</button>
                </div>
            </section>

            <section id="config-tab-image-prompts"
                     class="config-tab-panel"
                     data-config-tab-panel="image-prompts"
                     aria-labelledby="config-tab-button-image-prompts"
                     role="tabpanel"
                     hidden>
                <div class="config-sections config-sections--single-column">
                    <div class="config-section">
                        <h2>🖌️ Global Image Prompt Instructions</h2>
                        <p class="help-text">These instructions guide the LLM that writes final image prompts. A nonblank World Profile → Image Prompt Generation value overrides its matching global field.</p>
                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label for="image-prompt-instructions-character">Character Prompt Instructions</label>
                                <textarea id="image-prompt-instructions-character"
                                          name="imagegen.image_prompt_instructions.character::string"
                                          rows="6"
                                          placeholder="Global instructions for character image prompts...">{{ config.imagegen.image_prompt_instructions.character or '' }}</textarea>
                            </div>

                            <div class="form-group full-width">
                                <label for="image-prompt-instructions-location">Location Prompt Instructions</label>
                                <textarea id="image-prompt-instructions-location"
                                          name="imagegen.image_prompt_instructions.location::string"
                                          rows="6"
                                          placeholder="Global instructions for location image prompts...">{{ config.imagegen.image_prompt_instructions.location or '' }}</textarea>
                            </div>

                            <div class="form-group full-width">
                                <label for="image-prompt-instructions-item">Item Prompt Instructions</label>
                                <textarea id="image-prompt-instructions-item"
                                          name="imagegen.image_prompt_instructions.item::string"
                                          rows="6"
                                          placeholder="Global instructions for item image prompts...">{{ config.imagegen.image_prompt_instructions.item or '' }}</textarea>
                            </div>

                            <div class="form-group full-width">
                                <label for="image-prompt-instructions-scenery">Scenery Prompt Instructions</label>
                                <textarea id="image-prompt-instructions-scenery"
                                          name="imagegen.image_prompt_instructions.scenery::string"
                                          rows="6"
                                          placeholder="Global instructions for scenery image prompts...">{{ config.imagegen.image_prompt_instructions.scenery or '' }}</textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-actions form-actions--panel">
                    <button type="submit" class="btn btn-primary">💾 Save Image Prompt Instructions</button>
                </div>
            </section>
            </form>

            <section id="config-tab-game"
                     class="config-tab-panel"
                     data-config-tab-panel="game"
                     aria-labelledby="config-tab-button-game"
                     role="tabpanel"
                     hidden>
                <div class="config-section">
                    <h2>🎮 Game Configuration Override</h2>
                    <div class="form-grid">
                        <div class="form-group full-width">
                            <label for="game-config-override-yaml">Per-Game YAML Override:</label>
                            <textarea id="game-config-override-yaml"
                                      class="game-config-override-textarea"
                                      spellcheck="false"
                                      {% if not gameLoaded %}disabled{% endif %}>{{ gameConfigOverrideYaml }}</textarea>
                            {% if gameLoaded %}
                                <span class="help-text">This YAML is merged on top of `config.default.yaml`, `config.yaml`, and any CLI config override for the currently loaded game. Save explicitly to reload the merged runtime config and persist the raw YAML with the game.</span>
                            {% else %}
                                <span class="help-text">Load or start a game to edit the per-game YAML override. It stays disabled while no game is loaded.</span>
                            {% endif %}
                            <span class="help-text">This uses the same reload path as `/reload_config`. Mod enable/disable changes are validated immediately, but still require a restart to fully apply.</span>
                        </div>
                    </div>
                    <div class="game-config-actions">
                        <span id="game-config-save-state" class="game-config-save-state" aria-live="polite"></span>
                        <button type="button"
                                id="save-game-config-override"
                                class="btn btn-primary"
                                {% if not gameLoaded %}disabled{% endif %}>
                            💾 Save Game Configuration
                        </button>
                    </div>
                </div>
            </section>
            </div>
        </div>
    </div>

    {% include "_includes/image-workflow-preset-modal.njk" %}

    <div id="addModelModal" class="modal config-add-model-modal" role="dialog" aria-modal="true" aria-hidden="true" data-ctrl-enter-submit="#addModelConfirm" hidden>
        <div class="modal__dialog">
            <header class="modal__header">
                <h2>Add AI Model</h2>
                <button type="button" class="modal__close" id="addModelCancelClose" aria-label="Close add model dialog">✖️</button>
            </header>
            <div class="modal__body">
                <label for="newModelName">Model name</label>
                <input type="text" id="newModelName" placeholder="e.g., gpt-4o-mini">
                <p id="addModelError" class="help-text" style="color: rgb(255, 150, 150);" hidden></p>
            </div>
            <footer class="modal__footer">
                <button type="button" class="btn btn-secondary" id="addModelCancel">Cancel</button>
                <button type="button" class="btn btn-primary" id="addModelConfirm">Add Model</button>
            </footer>
        </div>
    </div>
    
    <script src="/js/config.js"></script>
    <script>
        // Dynamically enhance mod model selectors if needed
        document.addEventListener('DOMContentLoaded', () => {
            const modelOptionsInput = document.getElementById('model-options');
            let globalModelOptions = [];
            
            try {
                if (modelOptionsInput && modelOptionsInput.value) {
                    globalModelOptions = JSON.parse(modelOptionsInput.value || '[]');
                }
            } catch (e) {
                console.warn('Failed to parse global model options for mods:', e);
            }

            // Find all mod configuration selects that look like model selectors (heuristic: label contains "Model")
            // Or better yet, we can check if the schema has type 'model_select' in the future.
            // For now, let's look for known keys or just rely on standard select.
            
            // Actually, if the schema provided options, they are rendered. 
            // If we want to inject global model options into a mod select simply,
            // we'd need to update the mod schema to support 'dynamic_options': 'models' or similar.
            // For this iteration, we'll assume the mod provides a text input for model or a simple select.
            // BUT the user asked to "setup distinct text ai model" and "use this model instead of default".
            // It would be nice to offer the same dropdown as the main AI config.
            
            // Let's rely on the mod schema defining options for now. The mod implementation will handle getting the list.
        });
    </script>
</body>
</html>
