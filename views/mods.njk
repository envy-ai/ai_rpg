<!DOCTYPE html>
<html lang="en">
{% set pageTitleValue = title | default("Mods") %}
<head>
    {% include "_includes/head-common.njk" %}
    <link rel="stylesheet" href="/css/config.css">
</head>
<body>
    <div class="container">
        {% set appHeaderTitle = 'Mods' %}
        {% set appHeaderSubtitle = 'Enable or disable runtime mods' %}
        {% include "_includes/app-header.njk" %}

        <main class="config-content">
            <div id="mods-status-message" class="status-message" hidden></div>
            <section class="config-section">
                <h2>Mod Manager</h2>
                <p class="help-text">Changing enabled mods updates config.yaml. Runtime hooks and defs overlays reload only after restart.</p>
                <div id="mods-restart-warning" class="warning-message" {% if not modState.restartRequired %}hidden{% endif %}>
                    Restart required for configured mod changes to become active.
                </div>
                <form id="mods-manager-form">
                    <div id="mods-manager-list" class="form-grid">
                        {% for mod in modState.mods %}
                        <div class="form-group full-width">
                            <label for="mod-enabled-{{ mod.name }}">{{ mod.name }}</label>
                            <div class="checkbox-wrapper">
                                <input type="checkbox"
                                       id="mod-enabled-{{ mod.name }}"
                                       value="{{ mod.name }}"
                                       data-mod-enabled-checkbox="true"
                                       {% if mod.configuredEnabled %}checked{% endif %}>
                            </div>
                            <span class="help-text">
                                Active now: {{ "yes" if mod.activeEnabled else "no" }}.
                                Contains: {{ "mod.js" if mod.hasModJs else "" }}{% if mod.hasModJs and mod.hasDefsDir %}, {% endif %}{{ "defs" if mod.hasDefsDir else "" }}.
                                {% if mod.restartRequired %}Restart required for this change.{% endif %}
                            </span>
                        </div>
                        {% endfor %}
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Save Mod Selection</button>
                        <button type="button" class="btn btn-secondary" id="mods-refresh-button">Refresh</button>
                    </div>
                </form>
            </section>
        </main>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('mods-manager-form');
        const list = document.getElementById('mods-manager-list');
        const status = document.getElementById('mods-status-message');
        const warning = document.getElementById('mods-restart-warning');
        const refreshButton = document.getElementById('mods-refresh-button');

        const listeners = new AbortController();
        const view = new window.AIRPG_WIDGETS.CollectionView(list);
        const statusView = new window.AIRPG_WIDGETS.StatusSurface(status, {
            stateClasses: { info: 'info', success: 'success', error: 'error' }
        });
        let disposed = false;
        let refreshRequest = 0;
        function setStatus(message, type = 'info') {
            if (!disposed) statusView.update({ text: message, state: type });
        }
        function report(error, prefix, returnFocus) {
            if (disposed) return;
            setStatus(`${prefix}: ${error.message}`, 'error');
            console.error(error);
            window.AIRPG_PAGE_FEEDBACK.showError(error, { returnFocus });
        }
        async function request(url, options) {
            const response = await fetch(url, options);
            const data = await response.json();
            if (!response.ok || !data.success) {
                const error = new Error(data.error || `HTTP ${response.status}`);
                if (data.stack) error.stack = data.stack;
                throw error;
            }
            return data;
        }

        function collectEnabledMods() {
            return Array.from(list.querySelectorAll('[data-mod-enabled-checkbox="true"]'))
                .filter(checkbox => checkbox.checked)
                .map(checkbox => checkbox.value);
        }

        function renderMods(state) {
            if (!state || !Array.isArray(state.mods)) throw new TypeError('Mod Manager response requires modState.mods.');
            view.render({ items: state.mods, keepVisibleWhenEmpty: true, renderItem(mod) {
                const contains = [
                    mod.hasModJs ? 'mod.js' : '',
                    mod.hasDefsDir ? 'defs' : ''
                ].filter(Boolean).join(', ');
                const group = document.createElement('div');
                group.className = 'form-group full-width';

                const label = document.createElement('label');
                label.setAttribute('for', `mod-enabled-${mod.name}`);
                label.textContent = mod.name;

                const wrapper = document.createElement('div');
                wrapper.className = 'checkbox-wrapper';

                const checkbox = document.createElement('input');
                checkbox.type = 'checkbox';
                checkbox.id = `mod-enabled-${mod.name}`;
                checkbox.value = mod.name;
                checkbox.dataset.modEnabledCheckbox = 'true';
                checkbox.checked = mod.configuredEnabled === true;
                wrapper.appendChild(checkbox);

                const help = document.createElement('span');
                help.className = 'help-text';
                help.textContent = `Active now: ${mod.activeEnabled ? 'yes' : 'no'}. Contains: ${contains || 'metadata only'}. ${mod.restartRequired ? 'Restart required for this change.' : ''}`;

                group.appendChild(label);
                group.appendChild(wrapper);
                group.appendChild(help);
                return group;
            } });
            if (warning) {
                warning.hidden = !state.restartRequired;
            }
        }

        async function refreshMods() {
            const ticket = ++refreshRequest;
            try {
                const data = await request('/api/mods/manager', { cache: 'no-store' });
                if (!disposed && ticket === refreshRequest) renderMods(data.modState);
            } catch (error) {
                if (!disposed && ticket === refreshRequest) report(error, 'Refresh failed', refreshButton);
            }
        }
        refreshButton.addEventListener('click', () => void refreshMods(), { signal: listeners.signal });

        if (form) {
            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                setStatus('Saving mod selection...', 'info');
                try {
                    const data = await request('/api/mods/enabled', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ enabledMods: collectEnabledMods() })
                    });
                    if (disposed) return;
                    // A committed configuration supersedes older in-flight read snapshots.
                    ++refreshRequest;
                    renderMods(data.modState);
                    setStatus(data.restartRequired
                        ? 'Mod selection saved. Restart required before changes are active.'
                        : 'Mod selection saved.',
                        'success');
                } catch (error) {
                    report(error, 'Save failed', form.querySelector('[type="submit"]'));
                }
            }, { signal: listeners.signal });
        }
        window.addEventListener('pagehide', event => {
            if (event.persisted || disposed) return;
            disposed = true; ++refreshRequest; listeners.abort(); view.destroy(); statusView.destroy();
        }, { signal: listeners.signal });
    }, { once: true });
    </script>
</body>
</html>
